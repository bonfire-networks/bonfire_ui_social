<nav id="feed-tabs" aria-label={l("Feeds")} class="w-full min-w-0">
  <ul class="flex flex-nowrap gap-2 overflow-x-auto overscroll-x-contain p-2">
    <li :for={preset <- @presets} class="shrink-0 min-w-[max(16%,7rem)]">
      <LinkLive
        to={preset.href}
        opts={[id: "feed-tab-" <> preset.slug, "aria-current": if(preset.active?, do: "page", else: nil)]}
        class={[
          "flex items-center justify-center gap-2 whitespace-nowrap rounded-full border px-2 py-1 text-sm font-semibold transition-colors duration-150 motion-reduce:transition-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content",
          "border-primary bg-primary text-primary-content": preset.active?,
          "border-base-content/10 bg-base-200 text-base-content/70 hover:bg-base-300 hover:text-base-content": not preset.active?
        ]}
      >
        <span aria-hidden="true" class="flex shrink-0 items-center">
          <Iconify.iconify icon={preset.icon} class="size-5" />
        </span>
        <span>{preset.name}</span>
      </LinkLive>
    </li>
  </ul>
</nav>
