<ul class="menu p-0 w-full px-0 lg:px-card gap-0">
  <li :for={link <- @links} id={"sidebar-#{link.id}"} class="!block w-full min-w-0">
    <LinkLive
      to={link.href}
      opts={[id: "sidebar-#{link.id}-link", "aria-current": if(link.active?, do: "page", else: nil)]}
      class="flex w-full min-w-0 items-center gap-2 min-h-9 px-3 py-1.5 rounded-selector hover:bg-base-content/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary [@media(pointer:coarse)]:min-h-11"
    >
      <Iconify.iconify icon={link.icon} class="size-5 shrink-0 text-primary" />
      <span class={["truncate min-w-0 text-base", Bonfire.UI.Common.LinkWidgetLive.active_label_class(link.active?)]}>{link.label}</span>
    </LinkLive>
  </li>
</ul>
