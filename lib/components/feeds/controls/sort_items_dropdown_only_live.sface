<Dropdown
  id="order_dropdown_feed"
  position="bottom"
  wrapper_class="flex"
  trigger_class="btn btn-outline rounded-field bg-base-100 border-hair border-divider w-full capitalize"
>
  <:trigger>
    {#case {e(@feed_filters, :sort_by, :date_created), e(@feed_filters, :sort_order, :desc)}}
      {#match {:date_created, :desc}}
        <span class="flex items-center">
          <#Icon iconify="mdi:order-alphabetical-ascending" class="lg:hidden block size-4" />
          <span class="hidden lg:block">{l("Most recent")}</span>
        </span>
      {#match {:date_created, :asc}}
        <span class="flex items-center">
          <#Icon iconify="mdi:order-alphabetical-ascending" class="lg:hidden block size-4" />
          <span class="hidden lg:block">{l("Least recent")}</span>
        </span>
      {#match {:reply_count, :desc}}
        <span class="flex items-center">
          <#Icon iconify="ph:chat-circle-fill" class="lg:hidden block size-4" />
          <span class="hidden lg:block">{l("Most replied")}</span>
        </span>
      {#match {:reply_count, :asc}}
        <span class="flex items-center">
          <#Icon iconify="ph:chat-circle-fill" class="lg:hidden block size-4" />
          <span class="hidden lg:block">{l("Least replied")}</span>
        </span>
      {#match {:boost_count, :desc}}
        <span class="flex items-center">
          <#Icon iconify="ph:arrows-counter-clockwise-fill" class="lg:hidden block size-4" />
          <span class="hidden lg:block">{l("Most boosted")}</span>
        </span>
      {#match {:boost_count, :asc}}
        <span class="flex items-center">
          <#Icon iconify="ph:arrows-counter-clockwise-fill" class="lg:hidden block size-4" />
          <span class="hidden lg:block">{l("Least boosted")}</span>
        </span>
      {#match {:like_count, :desc}}
        <span class="flex items-center">
          <#Icon iconify="ph:fire-fill" class="lg:hidden block h-5 w-4.5" />
          <span class="hidden lg:block">{l("Most liked")}</span>
        </span>
      {#match {:like_count, :asc}}
        <span class="flex items-center">
          <#Icon iconify="ph:fire-fill" class="lg:hidden block h-5 w-4.5" />
          <span class="hidden lg:block">{l("Least liked")}</span>
        </span>
      {#match _}
        <span class="flex items-center">
          <#Icon iconify="mdi:order-alphabetical-ascending" class="lg:hidden block size-4" />
          <span class="hidden lg:block">{l("Most recent")}</span>
        </span>
    {/case}
    <#Icon iconify="mdi:chevron-down" class="size-4" />
  </:trigger>

  <li>
    <a
      phx-click="set_filter"
      phx-value-sort_by="date_created"
      phx-value-sort_order="desc"
      phx-target={@event_target}
      class="flex gap-3 px-2 text-base-content justify-between items-center"
    >
      {l("Most recent")}
      <div class="size-5 flex items-center justify-center border border-divider rounded-full">
        {#if e(@feed_filters, :sort_by, :date_created) == :date_created and
            e(@feed_filters, :sort_order, :desc) == :desc}
          <span class="size-3.5 bg-primary rounded-full" />
        {/if}
      </div>
    </a>
  </li>
  <li>
    <a
      phx-click="set_filter"
      phx-value-sort_by="date_created"
      phx-value-sort_order="asc"
      phx-target={@event_target}
      class="flex gap-3 justify-between items-center px-2 text-base-content"
    >
      {l("Least recent")}
      <div class="size-5 flex items-center justify-center border border-divider rounded-full">
        {#if e(@feed_filters, :sort_by, nil) == :date_created and e(@feed_filters, :sort_order, nil) == :asc}
          <span class="size-3.5 bg-primary rounded-full" />
        {/if}
      </div>
    </a>
  </li>

  <li>
    <a
      phx-click="set_filter"
      phx-value-sort_by="reply_count"
      phx-value-sort_order="desc"
      phx-target={@event_target}
      class="flex justify-between items-center gap-3 px-2 text-base-content"
    >
      {l("Most replied")}
      <div class="size-5 flex items-center justify-center border border-divider rounded-full">
        {#if e(@feed_filters, :sort_by, nil) == :reply_count and e(@feed_filters, :sort_order, nil) == :desc}
          <span class="size-3.5 bg-primary rounded-full" />
        {/if}
      </div>
    </a>
  </li>
  <li>
    <a
      phx-click="set_filter"
      phx-value-sort_by="reply_count"
      phx-value-sort_order="asc"
      phx-target={@event_target}
      class="flex gap-3 justify-between items-center px-2 text-base-content"
    >
      {l("Least replied")}
      <div class="size-5 flex items-center justify-center border border-divider rounded-full">
        {#if e(@feed_filters, :sort_by, nil) == :reply_count and e(@feed_filters, :sort_order, nil) == :asc}
          <span class="size-3.5 bg-primary rounded-full" />
        {/if}
      </div>
    </a>
  </li>

  {#if extension_enabled?(:bonfire_ui_reactions, @__context__)}
    <li>
      <a
        phx-click="set_filter"
        phx-value-sort_by="boost_count"
        phx-value-sort_order="desc"
        phx-target={@event_target}
        class="flex justify-between items-center gap-3 px-2 text-base-content"
      >
        {l("Most boosted")}
        <div class="size-5 flex items-center justify-center border border-divider rounded-full">
          {#if e(@feed_filters, :sort_by, nil) == :boost_count and e(@feed_filters, :sort_order, nil) == :desc}
            <span class="size-3.5 bg-primary rounded-full" />
          {/if}
        </div>
      </a>
    </li>
    <li>
      <a
        phx-click="set_filter"
        phx-value-sort_by="boost_count"
        phx-value-sort_order="asc"
        phx-target={@event_target}
        class="flex justify-between items-center gap-3 px-2 text-base-content"
      >
        {l("Least boosted")}
        <div class="size-5 flex items-center justify-center border border-divider rounded-full">
          {#if e(@feed_filters, :sort_by, nil) == :boost_count and e(@feed_filters, :sort_order, nil) == :asc}
            <span class="size-3.5 bg-primary rounded-full" />
          {/if}
        </div>
      </a>
    </li>

    <li>
      <a
        phx-click="set_filter"
        phx-value-sort_by="like_count"
        phx-value-sort_order="desc"
        phx-target={@event_target}
        class="flex gap-3 px-2 justify-between items-center text-base-content"
      >
        {l("Most liked")}
        <div class="size-5 flex items-center justify-center border border-divider rounded-full">
          {#if e(@feed_filters, :sort_by, nil) == :like_count and e(@feed_filters, :sort_order, nil) == :desc}
            <span class="size-3.5 bg-primary rounded-full" />
          {/if}
        </div>
      </a>
    </li>
    <li>
      <a
        phx-click="set_filter"
        phx-value-sort_by="like_count"
        phx-value-sort_order="asc"
        phx-target={@event_target}
        class="flex justify-between items-center gap-3 px-2 text-base-content"
      >
        {l("Least liked")}
        <div class="size-5 flex items-center justify-center border border-divider rounded-full">
          {#if e(@feed_filters, :sort_by, nil) == :like_count and e(@feed_filters, :sort_order, nil) == :asc}
            <span class="size-3.5 bg-primary rounded-full" />
          {/if}
        </div>
      </a>
    </li>
  {/if}
</Dropdown>
