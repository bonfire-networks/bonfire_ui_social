{#case Bonfire.UI.Social.ToggleTypeLive.tri_state(
    @key,
    e(@feed_filters, @field, []),
    e(@feed_filters, Bonfire.Common.Types.maybe_to_atom("exclude_#{@field}"), [])
  )}
  {#match state}
    {!-- quiet tri-state row: the control shows the state, the label stays plain --}
    <div data-toggle={@key} data-state={state} class="flex items-center justify-between gap-3 min-h-10">
      <span class="text-sm text-base-content truncate">{@label}</span>

      <div
        role="radiogroup"
        aria-label={l("Filter mode for %{label}", label: @label)}
        class="inline-flex items-center rounded-full bg-base-content/[0.06] p-0.5 text-[13px] font-medium shrink-0"
      >
        <button
          type="button"
          role="radio"
          data-id="only"
          aria-checked={if state == :only, do: "true", else: "false"}
          title={l("Show only this — hide everything else")}
          phx-click={@event_name}
          phx-value-toggle={@field}
          phx-value-toggle_type={@key}
          phx-value-toggle_value={if state == :only, do: "default", else: "true"}
          phx-target={@event_target}
          class={
            "relative min-h-11 min-w-11 px-3 rounded-full transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 focus-visible:ring-offset-base-100",
            "text-muted hover:text-base-content": state != :only,
            "bg-base-100 text-primary shadow-sm": state == :only
          }
        >
          <span aria-hidden="true">{l("Only")}</span>
          <span class="sr-only">{l("Show only %{label} — hide everything else", label: @label)}</span>
        </button>
        <button
          type="button"
          role="radio"
          data-id="default"
          aria-checked={if state == :default, do: "true", else: "false"}
          title={l("Show alongside everything else (default)")}
          phx-click={@event_name}
          phx-value-toggle={@field}
          phx-value-toggle_type={@key}
          phx-value-toggle_value="default"
          phx-target={@event_target}
          class={
            "relative min-h-11 min-w-11 px-3 rounded-full transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 focus-visible:ring-offset-base-100",
            "text-muted hover:text-base-content": state != :default,
            "bg-base-100 text-base-content shadow-sm": state == :default
          }
        >
          <span aria-hidden="true">{@label_default || l("Include")}</span>
          <span class="sr-only">{l("Show %{label} alongside everything else", label: @label)}</span>
        </button>
        <button
          type="button"
          role="radio"
          data-id="hide"
          aria-checked={if state == :hide, do: "true", else: "false"}
          title={l("Hide this from the feed")}
          phx-click={@event_name}
          phx-value-toggle={@field}
          phx-value-toggle_type={@key}
          phx-value-toggle_value={if state == :hide, do: "default", else: "false"}
          phx-target={@event_target}
          class={
            "relative min-h-11 min-w-11 px-3 rounded-full transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 focus-visible:ring-offset-base-100",
            "text-muted hover:text-base-content": state != :hide,
            "bg-base-100 text-error shadow-sm": state == :hide
          }
        >
          <span aria-hidden="true">{l("Hide")}</span>
          <span class="sr-only">{l("Hide %{label} from the feed", label: @label)}</span>
        </button>
      </div>
    </div>
{/case}
