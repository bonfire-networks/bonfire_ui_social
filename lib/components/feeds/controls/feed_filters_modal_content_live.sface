<div class="flex flex-col max-h-[calc(100vh-10rem)]">
  {#if @title || (@show_reset && @active_filters != [])}
    <div class="flex items-center justify-between gap-3 min-h-10 pb-1">
      <h3 :if={@title} class="text-base font-semibold text-base-content">{@title}</h3>
      <span :if={!@title} />
      {#if @show_reset && @active_filters != []}
        <button
          type="button"
          phx-click="reset_pending"
          phx-target={@myself}
          class="h-8 px-2 rounded-selector text-sm text-muted hover:text-base-content hover:bg-base-content/5 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 focus-visible:ring-offset-base-100"
          data-role="reset_filters"
        >
          {l("Reset %{count}", count: length(@active_filters))}
        </button>
      {/if}
    </div>
  {/if}

  <p :if={@description} class="text-xs text-muted pb-2">{@description}</p>

  <div class="flex flex-col divide-hair divide-secondary overflow-y-auto flex-1 min-h-0">
    {!-- WHERE IT WAS POSTED --}
    <details
      :if={:origin in @sections}
      class="group"
      data-row="origin"
      id={"#{@id}_origin_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 id={"#{@id}_origin_label"} class="text-xs uppercase font-normal text-muted">{l("Origin")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate max-w-[180px]",
              "text-primary":
                !Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, :all),
              "text-muted":
                Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, :all)
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.origin_summary(@pending_filters)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <div class="pb-3 flex flex-col gap-2">
        {#case @preset_origin_info}
          {#match %{preset_has_fixed_origin: true, preset_origin: preset_origin}}
            <p class="text-sm text-muted" title={l("Fixed for this feed")}>
              {l("This feed always shows content from %{origin}.",
                origin:
                  if(preset_origin == :local,
                    do: l("this instance"),
                    else: if(preset_origin == :remote, do: l("other instances"), else: l("anywhere"))
                  )
              )}
            </p>
          {#match _}
            {!-- stacked options (a segmented control wraps at sidebar width) --}
            <div role="radiogroup" aria-labelledby={"#{@id}_origin_label"} class="flex flex-col">
              {#for {value, label} <- [
                  {:all, l("Anywhere")},
                  {:local, l("This instance")},
                  {:remote, l("Other instances")}
                ]}
                <button
                  type="button"
                  role="radio"
                  aria-checked={if Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, value),
                    do: "true",
                    else: "false"}
                  phx-click="set_filter"
                  phx-value-origin={value}
                  phx-target={@myself}
                  class={
                    "flex items-center justify-between gap-3 min-h-10 px-2 -mx-2 rounded-selector text-sm text-left transition-colors duration-150 hover:bg-base-content/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 focus-visible:ring-offset-base-100",
                    "text-primary font-medium":
                      Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, value),
                    "text-base-content":
                      not Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, value)
                  }
                >
                  <span>{label}</span>
                  <span
                    :if={Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, value)}
                    aria-hidden="true"
                    class="text-primary"
                  >✓</span>
                </button>
              {/for}
            </div>
            {!-- specific instances: only offered once "Other instances" is chosen --}
            {#if Bonfire.UI.Social.FeedFiltersModalContentLive.show_instances?(@pending_filters)}
              <form
                id={"#{@id}_instances_form"}
                phx-change="set_instances"
                phx-submit="set_instances"
                phx-target={@myself}
              >
                <label for={"#{@id}_instances"} class="block text-xs text-muted mb-1">{l("Only these instances")}</label>
                <input
                  id={"#{@id}_instances"}
                  type="text"
                  name="instances_text"
                  value={@pending_instances_text}
                  placeholder={l("mastodon.social, gancio.org")}
                  autocomplete="off"
                  spellcheck="false"
                  class="input input-sm w-full text-base"
                />
              </form>
            {/if}
        {/case}
      </div>
    </details>

    <div :if={:hide_own in @sections and current_user_id(@__context__)} data-row="hide_own">
      <label class="flex min-h-12 cursor-pointer items-center justify-between gap-3">
        <span class="text-xs uppercase font-normal text-muted">{l("Hide my own activities")}</span>
        <input
          id={"feed_filter_hide_own_activities_#{@feed_name || "custom"}"}
          type="checkbox"
          checked={@user_activities_excluded?}
          class="toggle toggle-primary toggle-sm"
          phx-click="set_filter"
          phx-value-toggle="subjects"
          phx-value-toggle_type={current_user_id(@__context__)}
          phx-value-toggle_value={if @user_activities_excluded?, do: "default", else: "false"}
          phx-target={@myself}
        />
      </label>
    </div>

    {!-- FROM PEOPLE --}
    <details
      :if={:from_people in @sections}
      class="group"
      data-row="from_people"
      id={"#{@id}_from_people_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 class="text-xs uppercase font-normal text-muted">{l("From people")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate max-w-[180px]",
              "text-primary": @selected_authors != [],
              "text-muted": @selected_authors == []
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.people_summary(@selected_authors, :include)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <div class="pb-3 flex flex-col gap-1">
        <form phx-change="multi_select" phx-target={@myself} id={"#{@id}_author_form"}>
          <Bonfire.UI.Common.MultiselectLive.UserSelectorLive
            implementation={:live_select}
            mode={:tags}
            variant={:filter}
            label={l("Type a name or @handle")}
            form_input_name={"#{@id}_include_people"}
            selected_options={@selected_authors}
            event_target={@myself}
            debounce={300}
          />
        </form>
        <p class="text-xs text-muted">{l("Backspace removes the last person")}</p>
      </div>
    </details>

    {!-- NOT FROM PEOPLE --}
    <details
      :if={:not_people in @sections}
      class="group"
      data-row="not_people"
      id={"#{@id}_not_people_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 class="text-xs uppercase font-normal text-muted">{l("Not from people")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate max-w-[180px]",
              "text-primary": @selected_excluded_authors != [],
              "text-muted": @selected_excluded_authors == []
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.people_summary(@selected_excluded_authors, :exclude)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <div class="pb-3 flex flex-col gap-1">
        <form phx-change="multi_select_exclude" phx-target={@myself} id={"#{@id}_exclude_author_form"}>
          <Bonfire.UI.Common.MultiselectLive.UserSelectorLive
            implementation={:live_select}
            mode={:tags}
            variant={:filter}
            label={l("Type a name or @handle")}
            form_input_name={"#{@id}_exclude_people"}
            selected_options={@selected_excluded_authors}
            event_target={@myself}
            debounce={300}
          />
        </form>
        <p class="text-xs text-muted">{l("Their posts are left out even when they match everything else.")}</p>
      </div>
    </details>

    {!-- HASHTAGS --}
    <details
      :if={:hashtags in @sections}
      class="group"
      data-row="hashtags"
      id={"#{@id}_hashtags_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 class="text-xs uppercase font-normal text-muted">{l("Hashtags")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate max-w-[180px]",
              "text-primary": List.wrap(e(@pending_filters, :tags, [])) != [],
              "text-muted": List.wrap(e(@pending_filters, :tags, [])) == []
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.hashtags_summary(@pending_filters)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <form
        id={"#{@id}_tags_form"}
        phx-change="set_tags"
        phx-submit="set_tags"
        phx-target={@myself}
        class="pb-3"
      >
        <label for={"#{@id}_tags"} class="sr-only">{l("Hashtags")}</label>
        <input
          id={"#{@id}_tags"}
          type="text"
          name="tags_text"
          value={@pending_tags_text}
          placeholder={l("#bonfire #fediverse")}
          autocomplete="off"
          spellcheck="false"
          class="input input-sm w-full text-base"
        />
        <p class="text-xs text-muted mt-1">
          {#if length(List.wrap(e(@pending_filters, :tags, []))) > 1}
            {l("Shows posts with any of these tags")}
          {#else}
            {l("The # is optional")}
          {/if}
        </p>
      </form>
    </details>

    <details
      :if={:time_range in @sections}
      class="group"
      data-row="time_range"
      id={"#{@id}_time_range_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 class="text-xs uppercase font-normal text-muted">{l("Time range")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate",
              "text-primary": e(@pending_filters, :time_limit, 0) not in [nil, 0],
              "text-muted": e(@pending_filters, :time_limit, 0) in [nil, 0]
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.time_range_summary(@pending_filters)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <div class="pb-3 flex flex-wrap gap-2">
        {#for {days, label} <- Bonfire.UI.Social.TimeControlLive.default_options()}
          <button
            type="button"
            phx-click="set_filter"
            phx-value-time_limit={days}
            phx-target={@myself}
            class={
              "btn btn-sm",
              "btn-primary":
                e(@pending_filters, :time_limit, 0) == days or
                  (days == 0 and is_nil(e(@pending_filters, :time_limit, nil)))
            }
          >
            {label}
          </button>
        {/for}
      </div>
    </details>

    <details
      :if={:sort_order in @sections}
      class="group"
      data-row="sort_order"
      id={"#{@id}_sort_order_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 class="text-xs uppercase font-normal text-muted">{l("Sort order")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate",
              "text-primary": e(@pending_filters, :sort_order, nil) == :asc,
              "text-muted": e(@pending_filters, :sort_order, nil) != :asc
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.sort_order_summary(@pending_filters)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <div class="pb-3 flex flex-wrap gap-2">
        <button
          type="button"
          phx-click="set_filter"
          phx-value-sort_order={:desc}
          phx-target={@myself}
          class={"btn btn-sm", "btn-primary": e(@pending_filters, :sort_order, :desc) == :desc}
        >
          {l("Newest first")}
        </button>
        <button
          type="button"
          phx-click="set_filter"
          phx-value-sort_order={:asc}
          phx-target={@myself}
          class={"btn btn-sm", "btn-primary": e(@pending_filters, :sort_order, nil) == :asc}
        >
          {l("Oldest first")}
        </button>
      </div>
    </details>

    {!-- CONTENT TYPES --}
    <details
      :if={:object_types in @sections}
      class="group"
      data-row="object_types"
      id={"#{@id}_object_types_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 class="text-xs uppercase font-normal text-muted">{l("Content types")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate",
              "text-primary":
                Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :object_types),
              "text-muted":
                !Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(
                  @pending_filters,
                  :object_types
                )
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.types_summary(@pending_filters, :object_types)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <div class="pb-3 flex flex-col gap-1">
        {#for {key, label} <- [
              {:post, l("Posts")},
              {:article, l("Articles")},
              {"Edition", l("Books")},
              {:Event, l("Events")}
            ],
            key in @object_types}
          <Bonfire.UI.Social.ToggleTypeLive
            label={label}
            key={key}
            field={:object_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        {/for}
        {#for key
          when key not in [
                 :post,
                 "post",
                 Bonfire.Data.Social.Post,
                 :article,
                 "article",
                 :Event,
                 "Event",
                 "Edition"
               ] <-
            @pending_filters[:object_types] || []}
          <Bonfire.UI.Social.ToggleTypeLive
            label={String.capitalize(to_string(key))}
            key={key}
            field={:object_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        {/for}
        <p class="pt-1 text-xs text-muted"><b class="font-medium text-base-content/70">{l("Only")}</b> {l("shows just these")} · <b class="font-medium text-base-content/70">{l("Hide")}</b> {l("leaves them out")}</p>
      </div>
    </details>

    {#if :activity_types in @sections and extension_enabled?(:bonfire_ui_reactions, @__context__)}
      <details
        class="group"
        data-row="activity_types"
        id={"#{@id}_activity_types_section"}
        phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
      >
        <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
          <h4 class="text-xs uppercase font-normal text-muted">{l("Activity types")}</h4>
          <span class="flex items-center gap-2 min-w-0">
            <span
              data-role="row_value"
              class={
                "text-sm truncate",
                "text-primary":
                  Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(
                    @pending_filters,
                    :activity_types
                  ),
                "text-muted":
                  !Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(
                    @pending_filters,
                    :activity_types
                  )
              }
            >{Bonfire.UI.Social.FeedFiltersModalContentLive.types_summary(@pending_filters, :activity_types)}</span>
            <span
              aria-hidden="true"
              class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
            >›</span>
          </span>
        </summary>
        <div class="pb-3 flex flex-col gap-1">
          {#for {key, label} <- [
              {:boost, l("Boosts")},
              {:like, l("Likes")},
              {:follow, l("Follows")},
              {:reply, l("Replies")}
            ]}
            <Bonfire.UI.Social.ToggleTypeLive
              label={label}
              key={key}
              field={:activity_types}
              feed_filters={@pending_filters}
              event_target={@myself}
              event_name="set_filter"
              label_default={l("Include")}
            />
          {/for}
          {#for key when key not in [:boost, :like, :follow, :reply] <- @pending_filters[:activity_types] || []}
            <Bonfire.UI.Social.ToggleTypeLive
              label={String.capitalize(to_string(key))}
              key={key}
              field={:activity_types}
              feed_filters={@pending_filters}
              event_target={@myself}
              event_name="set_filter"
              label_default={l("Include")}
            />
          {/for}
        </div>
      </details>
    {/if}

    {!-- MEDIA --}
    <details
      :if={:media_types in @sections}
      class="group"
      data-row="media_types"
      id={"#{@id}_media_types_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 class="text-xs uppercase font-normal text-muted">{l("Media")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate max-w-[180px]",
              "text-primary":
                Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types),
              "text-muted":
                !Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types)
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.media_summary(@pending_filters, @media_types)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <div class="pb-3 flex flex-col gap-1">
        {!-- quick actions for the common cases --}
        <div class="flex flex-wrap gap-1.5 pb-2">
          <button
            type="button"
            phx-click="any_media"
            phx-target={@myself}
            aria-pressed={if Bonfire.UI.Social.FeedFiltersModalContentLive.any_media?(@pending_filters, @media_types),
              do: "true",
              else: "false"}
            class={
              "btn btn-sm",
              "btn-primary":
                Bonfire.UI.Social.FeedFiltersModalContentLive.any_media?(@pending_filters, @media_types),
              "btn-ghost":
                !Bonfire.UI.Social.FeedFiltersModalContentLive.any_media?(@pending_filters, @media_types)
            }
          >
            {l("Any media")}
          </button>
          <button
            type="button"
            phx-click="clear_media"
            phx-target={@myself}
            aria-pressed={if !Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types),
              do: "true",
              else: "false"}
            class={
              "btn btn-sm",
              "btn-primary":
                !Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types),
              "btn-ghost":
                Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types)
            }
          >
            {l("No preference")}
          </button>
        </div>
        {#for {key, label} <- [
              {:link, l("Links")},
              {:image, l("Images")},
              {:video, l("Videos")},
              {:audio, l("Audio")},
              {:research, l("Research publications")}
            ],
            key in @media_types}
          <Bonfire.UI.Social.ToggleTypeLive
            label={label}
            key={key}
            field={:media_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        {/for}
        {#for key
          when key not in [
                 :image,
                 :link,
                 :audio,
                 :video,
                 :research,
                 "image",
                 "link",
                 "audio",
                 "video",
                 "research"
               ] <-
            @pending_filters[:media_types] || []}
          <Bonfire.UI.Social.ToggleTypeLive
            label={String.capitalize(to_string(key))}
            key={key}
            field={:media_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        {/for}
      </div>
    </details>

    {#if :subject_types in @sections}
      {#for key <- @pending_filters[:subject_types] || []}
        <div class="py-2" data-row="subject_types">
          <Bonfire.UI.Social.ToggleTypeLive
            label={String.capitalize(to_string(key))}
            key={key}
            field={:subject_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        </div>
      {/for}
    {/if}

    <details
      :if={:circles in @sections}
      class="group"
      data-row="circles"
      id={"#{@id}_circles_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <h4 class="text-xs uppercase font-normal text-muted">{l("Filter by circles")}</h4>
        <span class="flex items-center gap-2 min-w-0">
          <span
            data-role="row_value"
            class={
              "text-sm truncate",
              "text-primary": List.wrap(e(@pending_filters, :subject_circles, [])) != [],
              "text-muted": List.wrap(e(@pending_filters, :subject_circles, [])) == []
            }
          >{Bonfire.UI.Social.FeedFiltersModalContentLive.circles_summary(@pending_filters)}</span>
          <span
            aria-hidden="true"
            class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
          >›</span>
        </span>
      </summary>
      <div class="pb-3">
        {#case @my_circles}
          {#match []}
            <p class="text-sm text-muted">
              {l(
                "You haven't created any circles yet. Create one in your boundary settings to filter by specific groups of people."
              )}
            </p>
          {#match my_circles}
            <div class="flex flex-col gap-1">
              {#for circle <- my_circles}
                <Bonfire.UI.Social.ToggleTypeLive
                  label={elem(circle, 1)[:name]}
                  key={elem(circle, 1)[:id]}
                  field={:subject_circles}
                  feed_filters={@pending_filters}
                  event_target={@myself}
                  event_name="set_filter"
                  label_default={l("Include")}
                />
              {/for}
            </div>
        {/case}
      </div>
    </details>

    <details
      :if={:save_preset in @sections}
      class="group"
      data-row="save_preset"
      id={"#{@id}_save_preset_section"}
      phx-mounted={Phoenix.LiveView.JS.ignore_attributes("open")}
    >
      <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-12">
        <span class="text-[15px] text-base-content">{l("Save as custom feed")}</span>
        <span
          aria-hidden="true"
          class="text-muted text-lg transition-transform duration-150 motion-reduce:transition-none group-open:rotate-90"
        >›</span>
      </summary>
      <div class="pb-3">
        <form
          id={"#{@id}_create_feed_preset"}
          class="w-full flex flex-col gap-2"
          phx-submit="Bonfire.Social.Feeds:preset_create"
          phx-target={@event_target}
        >
          <fieldset class="fieldset">
            <legend class="fieldset-legend">{l("Feed title")}</legend>
            <label for={"#{@id}_feed_name"} class="sr-only">{l("Feed title")}</label>
            <input
              id={"#{@id}_feed_name"}
              name="name"
              class="input w-full"
              placeholder={l("Add a title...")}
            />
          </fieldset>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">{l("Feed description")}</legend>
            <textarea
              name="description"
              class="textarea w-full h-20"
              placeholder={l("Optional — what's this feed for?")}
            />
          </fieldset>

          <fieldset class="fieldset">
            <label class="fieldset-label cursor-pointer">
              <input type="checkbox" name="show_in_nav" checked="checked" class="checkbox checkbox-sm">
              <span class="text-sm text-base-content">{l("Show in feeds navbar")}</span>
            </label>
          </fieldset>

          <div class="flex justify-end">
            <.button type="submit" variant="primary" loading_text={l("Saving...")}>
              {l("Save feed")}
            </.button>
          </div>
        </form>
      </div>
    </details>
  </div>

  <div class="flex items-center justify-end gap-2 pt-3 shrink-0">
    <button
      type="button"
      phx-click="apply"
      phx-target={@myself}
      class="btn btn-sm btn-primary rounded-full px-6"
      data-role="apply_filters"
    >
      {l("Apply filters")}
    </button>
  </div>
</div>
