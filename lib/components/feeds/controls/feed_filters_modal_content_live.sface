<div class="flex flex-col max-h-[calc(100vh-10rem)]">
  {#if @title || (@show_reset && @active_filters != [])}
    <div class="flex items-center justify-between gap-3 min-h-10 pb-1">
      <h3 :if={@title} class="text-base font-bold text-base-content">{@title}</h3>
      <span :if={!@title} />
      {#if @show_reset && @active_filters != []}
        <button
          type="button"
          phx-click="reset_pending"
          phx-target={@myself}
          class="h-8 px-2 rounded-selector text-sm text-muted hover:text-base-content hover:bg-fill transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 focus-visible:ring-offset-base-100"
          data-role="reset_filters"
        >
          {l("Reset %{count}", count: length(@active_filters))}
        </button>
      {/if}
    </div>
  {/if}

  <p :if={@description} class="text-xs text-muted pb-2">{@description}</p>

  <div class="flex flex-col overflow-y-auto flex-1 min-h-0">
    {!-- WHERE IT WAS POSTED --}
    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:origin in @sections}
      id={@id}
      name="origin"
      label={l("Origin")}
      label_id={"#{@id}_origin_label"}
      value_class="max-w-45"
      active={!Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, :all)}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.origin_summary(@pending_filters)}
    >
      <div class="pb-3 flex flex-col gap-2">
        {#case @preset_origin_info}
          {#match %{preset_has_fixed_origin: true, preset_origin: preset_origin}}
            <p class="text-sm text-muted" title={l("Fixed for this feed")}>
              {l("This feed always shows content from %{origin}.",
                origin:
                  if(preset_origin == :local,
                    do: l("this instance"),
                    else: if(preset_origin == :remote, do: l("other instances"), else: l("anywhere"))
                  )
              )}
            </p>
          {#match _}
            {!-- stacked options (a segmented control wraps at sidebar width) --}
            <div role="radiogroup" aria-labelledby={"#{@id}_origin_label"} class="flex flex-col">
              {#for {value, label} <- [
                  {:all, l("Anywhere")},
                  {:local, l("This instance")},
                  {:remote, l("Other instances")}
                ]}
                <button
                  type="button"
                  role="radio"
                  aria-checked={if Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, value),
                    do: "true",
                    else: "false"}
                  phx-click="set_filter"
                  phx-value-origin={value}
                  phx-target={@myself}
                  class={
                    "flex items-center justify-between gap-3 min-h-10 px-2 -mx-2 rounded-selector text-sm text-left transition-colors duration-150 hover:bg-fill focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 focus-visible:ring-offset-base-100",
                    "text-primary font-medium":
                      Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, value),
                    "text-base-content":
                      not Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, value)
                  }
                >
                  <span>{label}</span>
                  <span
                    :if={Bonfire.UI.Social.FeedFiltersModalContentLive.origin_matches?(@pending_filters, value)}
                    aria-hidden="true"
                    class="text-primary"
                  >✓</span>
                </button>
              {/for}
            </div>
            {!-- specific instances: only offered once "Other instances" is chosen --}
            {#if Bonfire.UI.Social.FeedFiltersModalContentLive.show_instances?(@pending_filters)}
              <form
                id={"#{@id}_instances_form"}
                phx-change="set_instances"
                phx-submit="set_instances"
                phx-target={@myself}
              >
                <label for={"#{@id}_instances"} class="block text-xs text-muted mb-1">{l("Only these instances")}</label>
                <input
                  id={"#{@id}_instances"}
                  type="text"
                  name="instances_text"
                  value={@pending_instances_text}
                  placeholder={l("mastodon.social, gancio.org")}
                  autocomplete="off"
                  spellcheck="false"
                  class="input input-sm w-full text-base"
                />
              </form>
            {/if}
        {/case}
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    <div :if={:hide_own in @sections and current_user_id(@__context__)} data-row="hide_own">
      <label class="flex min-h-10 [@media(pointer:coarse)]:min-h-11 cursor-pointer items-center justify-between gap-3">
        <span class="text-sm font-normal text-muted">{l("Hide my own activities")}</span>
        <input
          id={"feed_filter_hide_own_activities_#{@feed_name || "custom"}"}
          type="checkbox"
          checked={@user_activities_excluded?}
          class="toggle toggle-primary toggle-xs"
          phx-click="set_filter"
          phx-value-toggle="subjects"
          phx-value-toggle_type={current_user_id(@__context__)}
          phx-value-toggle_value={if @user_activities_excluded?, do: "default", else: "false"}
          phx-target={@myself}
        />
      </label>
    </div>

    {!-- FROM PEOPLE --}
    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:from_people in @sections}
      id={@id}
      name="from_people"
      label={l("From people")}
      value_class="max-w-45"
      active={@selected_authors != []}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.people_summary(@selected_authors, :include)}
    >
      <div class="pb-3 flex flex-col gap-1">
        <form phx-change="multi_select" phx-target={@myself} id={"#{@id}_author_form"}>
          <Bonfire.UI.Common.MultiselectLive.UserSelectorLive
            implementation={:live_select}
            mode={:tags}
            variant={:filter}
            label={l("Type a name or @handle")}
            form_input_name={"#{@id}_include_people"}
            selected_options={@selected_authors}
            event_target={@myself}
            debounce={300}
          />
        </form>
        <p class="text-xs text-muted">{l("Backspace removes the last person")}</p>
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    {!-- NOT FROM PEOPLE --}
    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:not_people in @sections}
      id={@id}
      name="not_people"
      label={l("Not from people")}
      value_class="max-w-45"
      active={@selected_excluded_authors != []}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.people_summary(@selected_excluded_authors, :exclude)}
    >
      <div class="pb-3 flex flex-col gap-1">
        <form phx-change="multi_select_exclude" phx-target={@myself} id={"#{@id}_exclude_author_form"}>
          <Bonfire.UI.Common.MultiselectLive.UserSelectorLive
            implementation={:live_select}
            mode={:tags}
            variant={:filter}
            label={l("Type a name or @handle")}
            form_input_name={"#{@id}_exclude_people"}
            selected_options={@selected_excluded_authors}
            event_target={@myself}
            debounce={300}
          />
        </form>
        <p class="text-xs text-muted">{l("Their posts are left out even when they match everything else.")}</p>
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    {#if :subject_types in @sections}
      {#for key <- @pending_filters[:subject_types] || []}
        <div class="py-2" data-row="subject_types">
          <Bonfire.UI.Social.ToggleTypeLive
            label={String.capitalize(to_string(key))}
            key={key}
            field={:subject_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        </div>
      {/for}
    {/if}

    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:circles in @sections}
      id={@id}
      name="circles"
      label={l("Filter by circles")}
      active={List.wrap(e(@pending_filters, :subject_circles, [])) != []}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.circles_summary(@pending_filters)}
    >
      <div class="pb-3">
        {#case @my_circles}
          {#match []}
            <p class="text-sm text-muted">
              {l(
                "You haven't created any circles yet. Create one in your boundary settings to filter by specific groups of people."
              )}
            </p>
          {#match my_circles}
            <div class="flex flex-col gap-1">
              {#for circle <- my_circles}
                <Bonfire.UI.Social.ToggleTypeLive
                  label={elem(circle, 1)[:name]}
                  key={elem(circle, 1)[:id]}
                  field={:subject_circles}
                  feed_filters={@pending_filters}
                  event_target={@myself}
                  event_name="set_filter"
                  label_default={l("Include")}
                />
              {/for}
            </div>
        {/case}
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    {!-- HASHTAGS --}
    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:hashtags in @sections}
      id={@id}
      name="hashtags"
      label={l("Hashtags")}
      value_class="max-w-45"
      active={List.wrap(e(@pending_filters, :tags, [])) != []}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.hashtags_summary(@pending_filters)}
    >
      <form
        id={"#{@id}_tags_form"}
        phx-change="set_tags"
        phx-submit="set_tags"
        phx-target={@myself}
        class="pb-3"
      >
        <label for={"#{@id}_tags"} class="sr-only">{l("Hashtags")}</label>
        <input
          id={"#{@id}_tags"}
          type="text"
          name="tags_text"
          value={@pending_tags_text}
          placeholder={l("#bonfire #fediverse")}
          autocomplete="off"
          spellcheck="false"
          class="input input-sm w-full text-base"
        />
        <p class="text-xs text-muted mt-1">
          {#if length(List.wrap(e(@pending_filters, :tags, []))) > 1}
            {l("Shows posts with any of these tags")}
          {#else}
            {l("The # is optional")}
          {/if}
        </p>
      </form>
    </Bonfire.UI.Common.FeedFilterRowLive>

    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:time_range in @sections}
      id={@id}
      name="time_range"
      label={l("Posted")}
      active={e(@pending_filters, :time_limit, 0) not in [nil, 0]}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.time_range_summary(@pending_filters)}
    >
      <div class="pb-3 flex flex-wrap gap-2">
        <p class="w-full text-xs text-muted">{l("When it was posted")}</p>
        {#for {days, label} <- Bonfire.UI.Social.TimeControlLive.default_options()}
          <button
            type="button"
            phx-click="set_filter"
            phx-value-time_limit={days}
            phx-target={@myself}
            class={
              "btn btn-sm",
              "btn-primary":
                e(@pending_filters, :time_limit, 0) == days or
                  (days == 0 and is_nil(e(@pending_filters, :time_limit, nil)))
            }
          >
            {label}
          </button>
        {/for}
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    {!-- when things happen (eg. events), not when they were published: a preset, or two dates in advanced mode, in the viewer's time zone --}
    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:happening in @sections}
      id={@id}
      name="happening"
      label={l("Happening")}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.happening_summary(@pending_filters)}
    >
      <div class="pb-3 flex flex-col gap-3">
        <p class="text-xs text-muted">{l("When it happens. Only things with dates, like events.")}</p>
        <form phx-change="set_filter" phx-target={@myself}>
          <label for={"#{@id}_happening"} class="sr-only">{l("Happening")}</label>
          <select id={"#{@id}_happening"} name="happening" class="select select-sm w-full">
            <option value="">{l("Any time")}</option>
            {#for {value, label} <- Bonfire.UI.Social.FeedFiltersModalContentLive.happening_options()}
              <option value={value} selected={to_string(e(@pending_filters, :time_span, "")) == value}>{label}</option>
            {/for}
          </select>
        </form>
        <details class="text-sm">
          <summary class="cursor-pointer text-muted">{l("Advanced: pick dates")}</summary>
          <form
            phx-submit="set_filter"
            phx-target={@myself}
            class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 items-end"
          >
            <label class="flex flex-col gap-1">
              <span class="text-muted">{l("From")}</span>
              <input type="date" name="happening_from_date" class="input input-sm w-full">
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-muted">{l("Until")}</span>
              <input type="date" name="happening_until_date" class="input input-sm w-full">
            </label>
            <button type="submit" class="btn btn-sm sm:col-span-2">{l("Use these dates")}</button>
          </form>
        </details>
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    {!-- rows that extensions declare to come right after "Happening" (eg. "Nearby", geolocate's: things within a radius of the viewer), see `Bonfire.UI.Common.FeedFilterControlModule` --}
    {#for control <- @controls,
        control[:after] == :happening,
        control.name in @sections,
        module_enabled?(control.module, @__context__)}
      <StatelessComponent
        module={control.module}
        id={@id}
        feed_filters={@pending_filters}
        target={@myself}
        control_state={@control_state}
      />
    {/for}

    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:sort_order in @sections}
      id={@id}
      name="sort_order"
      label={l("Sort order")}
      active={e(@pending_filters, :sort_order, nil) == :asc or e(@pending_filters, :sort_by, nil) == :starts_at}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.sort_order_summary(@pending_filters)}
    >
      <div class="pb-3 flex flex-wrap gap-2">
        {!-- by when things happen (eg. events start), where there are things with dates: the host lists only those, or the draft has a Happening filter --}
        <button
          :if={Bonfire.UI.Social.FeedFiltersModalContentLive.starts_sort?(@pending_filters, @starts_sort)}
          type="button"
          phx-click="set_filter"
          phx-value-sort_by="starts_at"
          phx-target={@myself}
          class={"btn btn-sm", "btn-primary": e(@pending_filters, :sort_by, nil) == :starts_at}
        >
          {Bonfire.UI.Social.SortItemsDropdownLive.starts_sort_label(@pending_filters)}
        </button>
        <button
          type="button"
          phx-click="set_filter"
          phx-value-sort_order={:desc}
          phx-target={@myself}
          class={
            "btn btn-sm",
            "btn-primary":
              e(@pending_filters, :sort_by, nil) != :starts_at and
                e(@pending_filters, :sort_order, :desc) == :desc
          }
        >
          {l("Newest first")}
        </button>
        <button
          type="button"
          phx-click="set_filter"
          phx-value-sort_order={:asc}
          phx-target={@myself}
          class={
            "btn btn-sm",
            "btn-primary":
              e(@pending_filters, :sort_by, nil) != :starts_at and
                e(@pending_filters, :sort_order, nil) == :asc
          }
        >
          {l("Oldest first")}
        </button>
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    {!-- CONTENT TYPES --}
    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:object_types in @sections}
      id={@id}
      name="object_types"
      label={l("Content types")}
      active={Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :object_types)}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.types_summary(@pending_filters, :object_types)}
    >
      <div class="pb-3 flex flex-col gap-1">
        {#for {key, label} <- [
              {:post, l("Posts")},
              {:article, l("Articles")},
              {"Edition", l("Books")},
              {:Event, l("Events")}
            ],
            key in @object_types}
          <Bonfire.UI.Social.ToggleTypeLive
            label={label}
            key={key}
            field={:object_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        {/for}
        {#for key
          when key not in [
                 :post,
                 "post",
                 Bonfire.Data.Social.Post,
                 :article,
                 "article",
                 :Event,
                 "Event",
                 "Edition"
               ] <-
            @pending_filters[:object_types] || []}
          <Bonfire.UI.Social.ToggleTypeLive
            label={String.capitalize(to_string(key))}
            key={key}
            field={:object_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        {/for}
        <p class="pt-1 text-xs text-muted"><b class="font-medium text-muted">{l("Only")}</b> {l("shows just these")} · <b class="font-medium text-muted">{l("Hide")}</b> {l("leaves them out")}</p>
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    {#if :activity_types in @sections and extension_enabled?(:bonfire_ui_reactions, @__context__)}
      <Bonfire.UI.Common.FeedFilterRowLive
        id={@id}
        name="activity_types"
        label={l("Activity types")}
        active={Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :activity_types)}
        value={Bonfire.UI.Social.FeedFiltersModalContentLive.types_summary(@pending_filters, :activity_types)}
      >
        <div class="pb-3 flex flex-col gap-1">
          {#for {key, label} <- [
              {:boost, l("Boosts")},
              {:like, l("Likes")},
              {:follow, l("Follows")},
              {:reply, l("Replies")}
            ]}
            <Bonfire.UI.Social.ToggleTypeLive
              label={label}
              key={key}
              field={:activity_types}
              feed_filters={@pending_filters}
              event_target={@myself}
              event_name="set_filter"
              label_default={l("Include")}
            />
          {/for}
          {#for key when key not in [:boost, :like, :follow, :reply] <- @pending_filters[:activity_types] || []}
            <Bonfire.UI.Social.ToggleTypeLive
              label={String.capitalize(to_string(key))}
              key={key}
              field={:activity_types}
              feed_filters={@pending_filters}
              event_target={@myself}
              event_name="set_filter"
              label_default={l("Include")}
            />
          {/for}
        </div>
      </Bonfire.UI.Common.FeedFilterRowLive>
    {/if}

    {!-- MEDIA --}
    <Bonfire.UI.Common.FeedFilterRowLive
      :if={:media_types in @sections}
      id={@id}
      name="media_types"
      label={l("Media")}
      value_class="max-w-45"
      active={Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types)}
      value={Bonfire.UI.Social.FeedFiltersModalContentLive.media_summary(@pending_filters, @media_types)}
    >
      <div class="pb-3 flex flex-col gap-1">
        {!-- quick actions for the common cases --}
        <div class="flex flex-wrap gap-1.5 pb-2">
          <button
            type="button"
            phx-click="any_media"
            phx-target={@myself}
            aria-pressed={if Bonfire.UI.Social.FeedFiltersModalContentLive.any_media?(@pending_filters, @media_types),
              do: "true",
              else: "false"}
            class={
              "btn btn-sm",
              "btn-primary":
                Bonfire.UI.Social.FeedFiltersModalContentLive.any_media?(@pending_filters, @media_types),
              "btn-ghost":
                !Bonfire.UI.Social.FeedFiltersModalContentLive.any_media?(@pending_filters, @media_types)
            }
          >
            {l("Any media")}
          </button>
          <button
            type="button"
            phx-click="clear_media"
            phx-target={@myself}
            aria-pressed={if !Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types),
              do: "true",
              else: "false"}
            class={
              "btn btn-sm",
              "btn-primary":
                !Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types),
              "btn-ghost":
                Bonfire.UI.Social.FeedFiltersModalContentLive.types_filtered?(@pending_filters, :media_types)
            }
          >
            {l("No preference")}
          </button>
        </div>
        {#for {key, label} <- [
              {:link, l("Links")},
              {:image, l("Images")},
              {:video, l("Videos")},
              {:audio, l("Audio")},
              {:document, l("Documents")},
              {:research, l("Research publications")}
            ],
            key in @media_types}
          <Bonfire.UI.Social.ToggleTypeLive
            label={label}
            key={key}
            field={:media_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        {/for}
        {#for key
          when key not in [
                 :image,
                 :link,
                 :audio,
                 :video,
                 :research,
                 :document,
                 "image",
                 "link",
                 "audio",
                 "video",
                 "research",
                 "document"
               ] <-
            @pending_filters[:media_types] || []}
          <Bonfire.UI.Social.ToggleTypeLive
            label={String.capitalize(to_string(key))}
            key={key}
            field={:media_types}
            feed_filters={@pending_filters}
            event_target={@myself}
            event_name="set_filter"
            label_default={l("Include")}
          />
        {/for}
      </div>
    </Bonfire.UI.Common.FeedFilterRowLive>

    {!-- the other declared rows, last --}
    {#for control <- @controls,
        control[:after] != :happening,
        control.name in @sections,
        module_enabled?(control.module, @__context__)}
      <StatelessComponent
        module={control.module}
        id={@id}
        feed_filters={@pending_filters}
        target={@myself}
        control_state={@control_state}
      />
    {/for}

    <Bonfire.UI.Social.SaveFeedPresetLive
      :if={:save_preset in @sections}
      id={"#{@id}_save_preset_section"}
      event_target={@event_target}
    />
  </div>

  <div :if={!@apply_on_change} class="flex items-center justify-end gap-2 pt-3 shrink-0">
    <button
      type="button"
      phx-click="apply"
      phx-target={@myself}
      class="btn btn-sm btn-primary rounded-full px-6"
      data-role="apply_filters"
    >
      {l("Apply filters")}
    </button>
  </div>
</div>
