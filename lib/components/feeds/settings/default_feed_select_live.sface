<Bonfire.UI.Common.SettingsSelectLive
  stacked
  keys={[Bonfire.UI.Social.FeedLive, :default_feed]}
  id={@id}
  current_value={@default_feed}
  label_name={l("Default feed")}
  name={l("Default feed")}
  description={l("Opens from Feeds in the sidebar, and in Latest activity on your dashboard.")}
  options={@options}
  default_value={:my}
  scope={@scope}
/>
