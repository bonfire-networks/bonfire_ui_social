{!-- An icon button with a tooltip, or (`show_label`) a menu row with a switch, named by its visible text. --}
<button
  id={@id}
  type="button"
  phx-click="Bonfire.Social.Feeds:preset_nav_toggle"
  phx-value-id={@feed_name}
  phx-value-exclude={to_string(@pinned)}
  role={if @show_label, do: "switch"}
  aria-checked={if @show_label, do: to_string(@pinned)}
  aria-pressed={if !@show_label, do: to_string(@pinned)}
  data-tip={if !@show_label, do: @label}
  class={if @show_label,
    do: ["group", @class],
    else: [
      "tooltip tooltip-left btn btn-ghost btn-square shrink-0 rounded-lg p-0",
      @class,
      "text-primary": @pinned,
      "text-muted": !@pinned
    ]}
>
  <#Icon
    iconify={if @pinned, do: "ph:push-pin-simple-fill", else: "ph:push-pin-simple"}
    class={[
      "shrink-0",
      @icon_class,
      "text-primary": @show_label and @pinned,
      "text-muted": @show_label and !@pinned
    ]}
  />
  {#if @show_label}
    <span>{l("Show in feed tabs")}</span>
    <span
      aria-hidden="true"
      class="relative ml-auto h-5 w-8 shrink-0 rounded-full bg-base-content/20 transition-colors duration-150 ease-out group-aria-checked:bg-primary after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-base-100 after:shadow-sm after:transition-[translate] after:duration-200 after:ease-out group-aria-checked:after:translate-x-3 motion-reduce:transition-none motion-reduce:after:transition-none"
    />
  {#else}
    <span class="sr-only">{@label}</span>
  {/if}
</button>
