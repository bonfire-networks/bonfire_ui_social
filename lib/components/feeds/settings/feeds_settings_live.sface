<div id="feed-settings" class="flex flex-col gap-6 py-4">
  <p class="text-sm px-4 leading-relaxed text-muted">{l(
      "Customize your feed experience by configuring default display settings and managing which feeds appear in your feed tabs."
    )}</p>

  <div
    id="feed-settings-panel"
    class="m-4 rounded-xl border border-base-content/10 overflow-hidden"
  >
    <div class="grid grid-cols-1">
      <.form
        for={@default_feed_form}
        id="default-feed-form"
        class="p-5"
        phx-change="Bonfire.Common.Settings:set"
      >
        <Bonfire.UI.Common.SettingsSelectLive
          stacked
          keys={[Bonfire.UI.Social.FeedLive, :default_feed]}
          id="default-feed-select"
          current_value={@default_feed}
          label_name={l("Default feed")}
          name={l("Default feed")}
          description={l("Choose which feed opens when you click Feeds in the sidebar.")}
          options={Enum.map(@presets, fn preset -> {preset.id, FeedNavigation.get_name(preset, preset.id)} end)}
          default_value={:my}
          scope={@scope}
        />
      </.form>

      {!-- Disabled until default-sort behavior has sufficient coverage.
      <.form for={@default_feed_form} id="default-sort-form" data-scope="reactions_sort" class="p-5" phx-change="Bonfire.Common.Settings:set">
        <Bonfire.UI.Common.SettingsSelectLive
          stacked
          keys={[Bonfire.UI.Social.FeedLive, :sort_by]}
          label_name={l("Sort by")}
          id="set_default_sort"
          options={if extension_enabled?(:bonfire_ui_reactions, @__context__),
            do: [
              false: l("Chronological"),
              reply_count: l("Amount of replies"),
              boost_count: l("Amount of boosts"),
              like_count: l("Amount of likes")
            ],
            else: [
              false: l("Chronological"),
              reply_count: l("Amount of replies")
            ]}
          default_value={false}
          current_value={:load_from_settings}
          name={l("Default sort")}
          description={l(
            "Select the default sorting options for your feeds (can always change in the feed controls options)"
          )}
          scope={@scope}
        />
      </.form>
      --}
    </div>

    {!-- Disabled because pagination does not consume the user preference.
    <.form for={@default_feed_form} id="feed-pagination-form" class="p-5 border-t border-base-content/10" phx-change="Bonfire.Common.Settings:set">
      <Bonfire.UI.Common.Settings.NumberLive
        scope={@scope}
        name={l("How many items to show in feeds and other lists")}
        keys={[:default_pagination_limit]}
        unit={l("items")}
        class="input w-20 min-h-11 rounded-xl text-base shrink-0"
      />
    </.form>
    --}

    <.form
      for={@default_feed_form}
      id="feed-infinite-scroll-form"
      class="p-5 border-t border-base-content/10 [&_label>div>div]:flex-wrap [&_label]:gap-4 [&_input[type=checkbox]]:shrink-0"
      data-scope="infinite_scroll"
      phx-change="Bonfire.Common.Settings:set"
    >
      <Bonfire.UI.Common.SettingsToggleLive
        id="infinite_scroll_toggle"
        show_label={Settings.get([:ui, :infinite_scroll], :preload, context: @__context__) == true}
        label={l("Dark Pattern")}
        name={l("Infinite scrolling")}
        description={l(
          "Enable infinite scrolling (doom scrolling) instead of pre-loading activities that require clicking 'Show more' to see them"
        )}
        keys={[:ui, :infinite_scroll]}
        disabled_value={:preload}
        enabled_value
        default_value={:preload}
        scope={@scope}
      />
    </.form>
  </div>

  {#if @scope == :instance or
      !Bonfire.Common.Settings.get([:ui, :sidebar, :disable_feeds_customization], false, :instance)}
    <section aria-labelledby="feed-presets-heading" class="flex flex-col gap-3">
      <div class="flex items-start gap-3 px-4 mb-2">
        <#Icon iconify="ph:list-star-fill" class="size-5 shrink-0 mt-0.5 text-primary" />
        <div>
          <h2 id="feed-presets-heading" class="text-base font-semibold">{l("Feed presets")}</h2>
          <p class="mt-1 text-sm leading-5 text-muted">{l("Choose which feeds appear in your feed tabs. Drag pinned feeds to reorder them.")}</p>
        </div>
      </div>
      <ul
        id="feed-presets-panel"
        phx-hook={if @scope != :instance, do: "Draggable"}
        data-event="Bonfire.Social.Feeds:preset_nav_reorder"
        class="w-full divide-hair divide-y divide-secondary overflow-hidden"
      >
        {#for preset <- @presets || []}
          <li
            id={"feed-preset-#{preset.id}"}
            data-item={preset.id}
            data-sortable-item={if @scope != :instance and preset[:exclude_from_nav] == false, do: true}
            class="flex items-center gap-3 px-2 py-2"
          >
            <span
              :if={@scope != :instance and preset[:exclude_from_nav] == false}
              data-sortable-handler
              data-tip={l("Drag to reorder")}
              aria-hidden="true"
              class="tooltip tooltip-right cursor-grab active:cursor-grabbing text-muted p-1 [@media(pointer:coarse)]:hidden"
            >
              <#Icon iconify="ph:dots-six-vertical" class="size-4" />
            </span>
            <div class="size-8 rounded-lg bg-base-200 shrink-0 grid place-items-center text-muted">
              <Iconify.iconify icon={preset[:icon] || "ic:baseline-rss-feed"} class="size-5" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-semibold leading-5 break-words">{FeedNavigation.get_name(preset, preset.id)}</h3>
              <p class="mt-0.5 text-[13px] leading-5 text-muted break-words">{preset[:description]}</p>
            </div>
            <div class="flex shrink-0 items-center gap-1">
              <div class="w-9 [@media(pointer:coarse)]:w-11">
                <Bonfire.UI.Social.SubscribeFeedLive
                  :if={!preset[:current_user_required] and
                    module_enabled?(Bonfire.UI.Social.SubscribeFeedLive, @__context__)}
                  feed_name={preset.id}
                  icon_button_class="btn btn-ghost btn-square size-9 min-h-9 p-0 rounded-lg [@media(pointer:coarse)]:size-11 [@media(pointer:coarse)]:min-h-11 text-muted"
                  icon_class="size-5 shrink-0"
                  as_icon
                />
              </div>
              <button
                :if={!preset[:built_in]}
                id={"delete-feed-preset-#{preset.id}"}
                type="button"
                phx-click="Bonfire.Social.Feeds:preset_delete"
                phx-value-id={preset.id}
                class="btn btn-ghost btn-square size-9 min-h-9 p-0 rounded-lg [@media(pointer:coarse)]:size-11 [@media(pointer:coarse)]:min-h-11 text-error"
              >
                <#Icon iconify="ph:trash-bold" class="size-5 shrink-0" />
                <span class="sr-only">{l("Delete")}</span>
              </button>
              <Bonfire.UI.Social.FeedPinButtonLive
                id={"pin-feed-preset-#{preset.id}"}
                feed_name={preset.id}
                pinned={preset[:exclude_from_nav] == false}
                class={[
                  "size-9 min-h-9 [@media(pointer:coarse)]:size-11 [@media(pointer:coarse)]:min-h-11",
                  "bg-primary/10": preset[:exclude_from_nav] == false
                ]}
                icon_class="size-5"
              />
            </div>
          </li>
        {/for}
      </ul>
    </section>
  {/if}
</div>
