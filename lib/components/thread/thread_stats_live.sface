<div>
  <div
    class="relative feed_control_wrapper thread-stats flex items-center gap-3"
    role="region"
    aria-label={l("Thread stats and actions")}
  >
    {!-- Left: reaction counts, folded into this row so the thread has one
         metadata band rather than a separate bordered one above it --}
    <StatelessComponent
      module={maybe_component(Bonfire.UI.Social.Activity.FediverseReactionsLive, @__context__)}
      object={@object}
      boost_count={@thread_boost_count}
      like_count={@thread_like_count}
      quote_count={@thread_quote_count}
      thread_id={@thread_id}
    />

    {!-- Right: thread controls (remote actions are in the main post's more menu) --}
    <div
      :if={socket_connected?(@__context__) and current_user_id(@__context__)}
      class="flex items-center gap-1 ml-auto"
      role="group"
      aria-label={l("Thread controls")}
    >
      <#slot />
    </div>
  </div>
</div>
