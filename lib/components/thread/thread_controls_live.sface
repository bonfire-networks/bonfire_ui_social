<div :if={current_user_id(@__context__)} class="contents">
  <Dropdown
    id={"thread-view-options-#{@thread_id}"}
    position="bottom"
    menu={false}
    focus_on_open="input:checked"
    trigger_class="btn btn-sm btn-ghost !font-normal text-muted gap-1"
    label={l("View options")}
  >
    <:trigger>
      <span>{l("View options")}</span>
      <#Icon iconify="mdi:chevron-down" class="w-4 h-4 opacity-60" aria-hidden="true" />
    </:trigger>
    <fieldset class="p-2">
      <legend class="text-sm font-semibold">{l("Thread layout")}</legend>
      {#for {mode, label} <- [{:nested, l("Threaded replies")}, {:flat, l("Linear replies")}]}
        <label class="flex min-h-11 cursor-pointer items-center justify-between gap-3 px-2 text-base-content">
          <span>{label}</span>
          <input
            id={"thread-layout-#{@thread_id}-#{mode}"}
            type="radio"
            name={"thread-layout-#{@thread_id}"}
            value={mode}
            checked={if mode == :flat, do: @thread_mode == :flat, else: @thread_mode != :flat}
            class="radio radio-sm radio-primary"
            phx-click="set"
            phx-value-to_atoms="true"
            phx-value-thread_mode={mode}
            {...if mode == :flat and @sort_by == :latest_reply,
              do: %{"phx-value-sort_by" => "nil", "phx-value-sort_order" => "desc", "phx-value-assign_global" => "true"},
              else: %{}}
            phx-target={@event_target}
          />
        </label>
      {/for}
    </fieldset>
    <fieldset class="p-2">
      <legend class="text-sm font-semibold">{l("Sort order")}</legend>
      {#for {sort_by, sort_order, label} <-
        [{nil, :asc, if(@thread_mode != :flat, do: l("Thread order"), else: l("Oldest first"))},
         {nil, :desc, l("Newest first")}] ++
          (if @thread_mode != :flat, do: [{:latest_reply, :desc, l("Recently active")}], else: []) ++
          [{:reply_count, :desc, l("Most replies")}] ++
          (if extension_enabled?(:bonfire_ui_reactions, @__context__),
            do: [{:boost_count, :desc, l("Most boosts")}, {:like_count, :desc, l("Most liked")}, {:popularity_score, :desc, l("Trending")}],
            else: [])}
        <label class="flex min-h-11 cursor-pointer items-center justify-between gap-3 px-2 text-base-content">
          <span>{label}</span>
          <input
            id={"thread-sort-#{@thread_id}-#{sort_by || :default}-#{sort_order}"}
            type="radio"
            name={"thread-sort-#{@thread_id}"}
            value={"#{sort_by || :default}-#{sort_order}"}
            checked={@sort_by == sort_by && (if sort_order == :desc, do: @sort_order == :desc, else: @sort_order != :desc)}
            class="radio radio-sm radio-primary"
            phx-click="set"
            phx-value-to_atoms="true"
            phx-value-sort_by={sort_by || "nil"}
            phx-value-sort_order={sort_order}
            phx-value-assign_global="true"
            phx-target={@event_target}
          />
        </label>
      {/for}
    </fieldset>
  </Dropdown>
</div>
