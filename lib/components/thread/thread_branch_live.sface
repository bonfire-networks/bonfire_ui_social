<div
  id={@id}
  data-id="branch"
  class={
    "reply thread-level-#{@thread_level} flex relative",
    "": @thread_level == 1,
    "border-b border-secondary": @thread_mode == :flat
  }
>
  <div class="relative flex-1 w-full">
    {!-- Time-gap divider. Sits above the card wrapper so the absolute-positioned
         thread lines (anchored to the wrapper) shift down with the comment. --}
    <div
      :if={@time_gap_before}
      data-role="time-gap"
      class="flex items-center gap-1.5 pt-1 pb-2 text-xs text-base-content/60"
      style={"padding-left: calc(var(--comment-base-indent, 0px) + #{4 + (@visual_level - 1) * 34}px)"}
    >
      <#Icon iconify="ph:clock-counter-clockwise-duotone" class="w-3.5 h-3.5 shrink-0" />
      <span>{@time_gap_before}</span>
    </div>

    {!-- R1 piece A (parent trunk) + R2 collapse button. Wrapping CommentLive
         in a relative box lets piece A span the parent's card without
         overshooting into the children subtree. See THREAD_LINES.md §8 v3.
         The parent-connector elbow lives in here too, so a time-gap divider
         above pushes the whole line geometry down along with the comment. --}
    <div class="relative">
      <div
        :if={@parent_visual_level >= 1 && @visual_level > @parent_visual_level && @show_thread_lines}
        style={"left: calc(var(--comment-base-indent, 0px) + #{20 + (@parent_visual_level - 1) * 34}px); width: 18px; height: calc(var(--comment-top-inset, 0px) + 20px);"}
        class="absolute top-0 border-l-hair border-b-hair border-secondary z-30 pointer-events-none"
      />
      <div
        :if={@show_thread_lines &&
          (has_replies?(@threaded_replies) ||
             show_more_replies_button?(@comment, @thread_level, @depth_loaded, @threaded_replies_count))}
        id={"line-#{@id}"}
        phx-click={if has_replies?(@threaded_replies) do
          JS.hide(to: "#replies-#{@id}")
          |> JS.hide(to: "#collapse-minus-#{@id}")
          |> JS.show(to: "#collapse-plus-#{@id}")
          |> JS.show(to: "#collapse-summary-#{@id}")
          |> JS.set_attribute({"aria-expanded", "false"}, to: "#collapse-toggle-#{@id}")
          |> then(
            &if(@collapsed,
              do: JS.hide(&1, to: "#collapse-toggle-#{@id}"),
              else: JS.hide(&1, to: "#line-#{@id}")
            )
          )
        end}
        style={"left: calc(var(--comment-base-indent, 0px) + #{24 + (@visual_level - 1) * 34}px); top: calc(var(--comment-top-inset, 0px) + 36px)"}
        class={
          "absolute -bottom-1 border-l-hair border-secondary z-40 px-1 -ml-1 ",
          "cursor-pointer hover:border-l-2 hover:border-primary":
            current_user_id(@__context__) && has_replies?(@threaded_replies)
        }
      />

      {#if current_user_id(@__context__)}
        {!-- Collapse/expand button at the line junction --}
        <button
          :if={@show_thread_lines && has_replies?(@threaded_replies)}
          id={"collapse-toggle-#{@id}"}
          type="button"
          aria-label={l("Toggle replies")}
          aria-expanded={if @collapsed, do: "false", else: "true"}
          phx-click={collapse_toggle_js(@id, @collapsed)
          |> JS.toggle_attribute({"aria-expanded", "true", "false"})}
          style={"#{if @collapsed, do: "display:none; "}left: calc(var(--comment-base-indent, 0px) + #{20 + (@visual_level - 1) * 34}px); transform: translateX(-50%); top: calc(var(--comment-top-inset, 0px) + 54px); width: 32px; height: 32px"}
          class="group absolute z-50 flex items-center justify-center cursor-pointer"
        >
          <span
            style="width: 20px; height: 20px"
            class="flex items-center justify-center rounded-full border-hair border-secondary bg-base-100 group-hover:border-primary group-hover:bg-base-200 transition-colors"
          >
            <span
              id={"collapse-minus-#{@id}"}
              style={if @collapsed, do: "display:none", else: ""}
              class="text-secondary text-xs font-bold leading-none select-none"
            >&minus;</span>
            <span
              id={"collapse-plus-#{@id}"}
              style={if !@collapsed, do: "display:none", else: ""}
              class="text-secondary text-xs font-bold leading-none select-none"
            >+</span>
          </span>
        </button>
      {/if}

      <Bonfire.UI.Social.CommentLive
        comment={@comment}
        total_replies_in_thread={@total_replies_in_thread}
        thread_id={@thread_id}
        index={@index}
        highlight_reply_id={@highlight_reply_id}
        feed_id={@feed_id || @thread_id}
        current_url={@current_url}
        threaded_replies={@threaded_replies}
        thread_object={@thread_object}
        thread_level={@thread_level}
        visual_level={@visual_level}
        thread_mode={@thread_mode}
        showing_within={@showing_within || :thread}
        activity_inception={@activity_inception}
        activity_preloads={@activity_preloads}
        hide_actions={@hide_actions}
      />
    </div>

    {!-- Reply slot for portal teleport (used by EmbedCommentsLive embed) --}
    <div
      :if={@showing_within == :thread_embed}
      id={"reply-slot-#{id(@comment)}"}
      class="px-4 relative z-50"
    />

    {!-- Inline action slot for portal teleport (used by EmbedCommentsLive embed for report/block) --}
    <div
      :if={@showing_within == :thread_embed}
      id={"action-slot-#{id(@comment)}"}
      class="px-4 relative z-50"
    />

    {#if @thread_mode != :flat}
      <div class="relative">
        {#if show_more_replies_button?(@comment, @thread_level, @depth_loaded, @threaded_replies_count)}
          <div
            class="relative flex items-center"
            style={"padding-left: calc(var(--comment-base-indent, 0px) + #{34 + (@visual_level - 1) * 34}px)"}
          >
            {!-- Elbow connecting the parent trunk to the more-replies button,
                 same geometry as the child-avatar connector above --}
            <div
              :if={@show_thread_lines}
              style={"left: calc(var(--comment-base-indent, 0px) + #{20 + (@visual_level - 1) * 34}px); width: 18px; height: 16px;"}
              class="absolute top-0 border-l-hair border-b-hair border-secondary z-30 pointer-events-none"
            />
            {#if user_socket_connected?(@__context__)}
              <button
                data-id="load_more_replies"
                phx-click="Bonfire.Social.Threads:load_more_replies"
                phx-value-id={e(@comment, :id, nil)}
                phx-value-level={@thread_level + 1}
                phx-target={@myself}
                class="flex items-center visible p-2 pt-0 click:invisible"
              >
                <span class="btn btn-sm">{more_replies_label(@comment, @threaded_replies_count)}</span>
              </button>
            {#else}
              <LinkLive
                to={maybe_apply(
                  Bonfire.UI.Me.RemoteInteractionLive,
                  :generate_url,
                  [
                    l("read"),
                    l("replies"),
                    URIs.canonical_url(@comment),
                    @__context__
                  ],
                  fallback_return: "/login"
                )}
                class="btn btn-sm ml-2"
              >
                {more_replies_label(@comment, @threaded_replies_count)}</LinkLive>
            {/if}
          </div>
        {/if}

        {!-- Summary row shown while a branch is auto-collapsed: replier avatars + count, expanding via the same toggle chain as the +/− button. Only rendered when collapsed by default, so its presence means "this branch starts folded". --}
        {#if @collapsed}
          <div id={"collapse-summary-#{@id}"} class="relative">
            <div
              class="relative flex items-center"
              style={"padding-left: calc(var(--comment-base-indent, 0px) + #{44 + (@visual_level - 1) * 34}px)"}
            >
              {!-- Elbow connecting the parent trunk to the summary, same geometry as the more-replies button below --}
              <div
                :if={@show_thread_lines}
                style={"left: calc(var(--comment-base-indent, 0px) + #{20 + (@visual_level - 1) * 34}px); width: 18px; height: 16px;"}
                class="absolute top-0 border-l-hair border-b-hair border-secondary z-30 pointer-events-none"
              />
              <button
                data-id="expand_collapsed_replies"
                type="button"
                aria-controls={"replies-#{@id}"}
                aria-expanded="false"
                phx-click={collapse_toggle_js(@id, true)
                |> JS.toggle_attribute({"aria-expanded", "true", "false"}, to: "#collapse-toggle-#{@id}")}
                class="btn btn-sm btn-ghost bg-base-200/60 hover:bg-base-200 rounded-full normal-case font-normal flex items-center gap-2 my-1"
              >
                <span class="flex items-center -space-x-1.5">
                  {#for p <- reply_authors(@threaded_replies)}
                    <Bonfire.UI.Common.AvatarLive
                      parent_id={deterministic_dom_id(
                        __MODULE__,
                        id(p),
                        "collapsed_reply_author",
                        @id
                      )}
                      user_id={id(p)}
                      src={Media.avatar_url(p)}
                      title={e(p, :profile, :name, nil) || e(p, :character, :username, nil)}
                      wrapper_class="shrink-0 !w-5 !h-5 avatar border-0"
                      bg_class="rounded-full"
                      class="w-5 h-5 rounded-full ring-1 ring-base-100"
                    />
                  {/for}
                </span>
                <span class="text-base-content/70">
                  {lp("%{count} reply", "%{count} replies", sub_replies_count(@comment),
                    count: sub_replies_count(@comment)
                  )}
                </span>
                <#Icon iconify="ph:caret-down-bold" class="w-3 h-3 text-base-content/50" />
              </button>
            </div>
          </div>
        {/if}

        <div
          id={"replies-#{@id}"}
          data-id="show_replies"
          style={if @collapsed, do: "display: none", else: ""}
        >
          <div :if={@threaded_replies != []} class={"!ml-0": @thread_level < 1}>
            <div class={"replies replies-level-" <> to_string(@thread_level + 1) <> " "}>
              {#for {{subreply, sub_child_replies}, index} <- Enum.with_index(@threaded_replies || [])}
                <div class="relative">
                  {!-- R1 piece B: per-child trunk segment. Only non-last
                       siblings need it; the last sibling's own R2 elbow
                       takes over. See THREAD_LINES.md §8 v4. --}
                  <div
                    :if={@show_thread_lines && more_siblings_below?(@comment, index, @threaded_replies_count)}
                    style={"left: calc(var(--comment-base-indent, 0px) + #{20 + (@visual_level - 1) * 34}px)"}
                    class="absolute top-[18px] bottom-0 border-l-hair border-secondary z-0 pointer-events-none"
                  />
                  <StatefulComponent
                    module={maybe_component(Bonfire.UI.Social.ThreadBranchLive, @__context__)}
                    id={LiveHandler.component_id(id(subreply), "nested")}
                    total_replies_in_thread={@threaded_replies_count}
                    index={index}
                    comment={subreply}
                    thread_id={@thread_id}
                    highlight_reply_id={@highlight_reply_id}
                    thread_object={@thread_object}
                    feed_id={@feed_id || @thread_id}
                    threaded_replies={sub_child_replies}
                    thread_level={@thread_level + 1}
                    showing_within={@showing_within}
                    activity_inception={@activity_inception}
                    current_url={@current_url || current_url(@__context__)}
                    activity_preloads={@activity_preloads}
                    hide_actions={@hide_actions}
                    depth_loaded={@depth_loaded}
                    thread_reply_count={@thread_reply_count}
                    time_gap_before={time_gap_before(@comment, @threaded_replies, index)}
                  />
                </div>
              {/for}
            </div>
          </div>
        </div>
      </div>
    {/if}
  </div>
</div>
