<div id={"#{@id}_wrapper"} data-role="participants_list_wrapper">
  {#case e(assigns, :participants, [])}
    {#match participants when is_list(participants) and participants != []}
      <ul class={@list_class} data-role="participants_list">
        {#for participant <- if(@expanded, do: participants, else: Enum.take(participants, @limit))}
          <li class={@item_class}>
            <#slot {@default, participant: participant} />
          </li>
        {/for}
      </ul>

      {#if length(participants) > @limit}
        <button
          id={"#{@id}_toggle"}
          type="button"
          phx-click="toggle_participants"
          phx-target={@myself}
          data-role="toggle_participants"
          aria-expanded={if @expanded, do: "true", else: "false"}
          class={@toggle_class}
        >
          {#if @expanded}
            {l("Show less")}
          {#else}
            <#slot {@collapsed_label}>{l("Show %{count} more", count: length(participants) - @limit)}</#slot>
          {/if}
          <#Icon
            :if={@show_toggle_icon}
            iconify="ph:caret-down"
            class={
              "h-4 w-4 shrink-0 transition-transform duration-150 ease-out motion-reduce:transition-none",
              "rotate-180": @expanded
            }
          />
        </button>
      {/if}
    {#match _}
  {/case}
</div>
