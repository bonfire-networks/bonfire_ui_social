<div
  id={deterministic_dom_id(__MODULE__, id(@object), "fediverse_reactions", @parent_id)}
  data-role="fediverse_reactions"
  role="group"
  aria-label={l("Thread stats")}
  class="flex flex-wrap items-center gap-x-3 gap-y-1 px-2"
>
  {!-- Quote counters are disabled until their production query cost is addressed. Previously: [boost: @boost_count, like: @like_count, quote: @quote_count] --}
  {#for {reaction, count} <- [boost: @boost_count, like: @like_count]}
    <span :if={reaction != :boost} class="text-primary font-bold" aria-hidden="true">·</span>
    <StatelessComponent
      module={maybe_component(Bonfire.UI.Reactions.ReactionCounterLive, @__context__)}
      reaction={reaction}
      count={count || 0}
      thread_id={@thread_id || id(@object)}
      parent_id={@parent_id}
    />
  {/for}
</div>
