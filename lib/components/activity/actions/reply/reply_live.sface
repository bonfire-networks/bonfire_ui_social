<div data-role="reply_action" class="relative z-dropdown flex items-center">
  {!-- why it's refused, if it is, so the disabled button can say --}
  {#case if(@object_type != Bonfire.Data.Social.Message,
      do:
        Bonfire.Boundaries.interaction_refusal(@__context__, :reply, @object_boundary,
          target_user: @creator
        )
    )}
    {#match nil}
      <.icon_button
        icon="ph:arrow-bend-up-left"
        icon_class="size-4.5"
        aria_label={lc("verb: action", "Reply", [], :bonfire_social)}
        variant="ghost"
        size="sm"
        tooltip={lc("verb: action", "Reply", [], :bonfire_social)}
        tooltip_position="top"
        phx_click={if @event_target || @activity_component_id,
          do:
            Bonfire.Social.Feeds.LiveHandler.reply_to_activity(
              @event_target || "##{@activity_component_id}"
            ),
          else: "Bonfire.Social.Threads:reply"}
        phx_values={%{id: @object_id}}
        class={"text-muted hover:text-primary", @class}
        data-role="reply_enabled"
        data-id="action_reply"
      />
      <span
        data-role="reply_count"
        :if={show_activity_counts?(@show_counts, @__context__) && e(@reply_count, 0) > 0}
        class="text-xs text-muted tabular-nums"
      >
        {@reply_count}
      </span>
    {#match refusal}
      {#if @object_boundary}
        {!-- the tooltip on a wrapper, as a disabled button gets no hover (`pointer-events-none`) --}
        <span
          class="tooltip tooltip-top"
          data-tip={Bonfire.UI.Common.refusal_text(refusal, @cannot_reply_text || l("Cannot reply"))}
        >
          <.icon_button
            icon="ph:arrow-bend-up-left"
            icon_class="size-4.5"
            aria_label={Bonfire.UI.Common.refusal_text(refusal, @cannot_reply_text || l("Cannot reply"))}
            variant="ghost"
            size="sm"
            disabled
            class="text-base-content/20"
            data-role="reply_disabled"
            data-id="action_reply"
          />
        </span>
        <span
          data-role="reply_count"
          :if={show_activity_counts?(@show_counts, @__context__) && e(@reply_count, 0) > 0}
          class="text-xs text-muted tabular-nums"
        >
          {@reply_count}
        </span>
      {#else}
        <span class="loading loading-spinner loading-sm text-muted" />
      {/if}
  {/case}
</div>
