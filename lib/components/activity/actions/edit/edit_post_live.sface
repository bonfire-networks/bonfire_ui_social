<Bonfire.UI.Common.OpenModalLive
  id={deterministic_dom_id("edit_post", id(@object), @activity_component_id, @parent_id)}
  title_text={l("Edit")}
  form_opts={%{"phx-submit" => "Bonfire.Posts:edit", "phx-target" => "##{@activity_component_id}"}}
>
  <input type="hidden" name="post_id" value={id(@object)}>

  <div class="flex flex-col gap-2 mt-4">
    <input
      name="name"
      class="w-full input"
      autocomplete="off"
      placeholder={l("Title")}
      aria-label={l("Title")}
      value={e(@post_content, :name, nil)}
    />

    <input
      name="summary"
      class="w-full input"
      autocomplete="off"
      placeholder={l("CW")}
      aria-label={l("Content warning")}
      value={e(@post_content, :summary, nil)}
    />

    <textarea
      name="html_body"
      class="w-full h-32 textarea"
      autocomplete="off"
      placeholder={l("Text")}
      aria-label={l("Text")}
    >{e(@post_content, :html_body, nil)}</textarea>
  </div>

  <:open_btn>
    <div class="flex items-center gap-3 w-full text-sm text-base-content">
      <#Icon iconify="ph:pencil-simple-line-fill" class="size-4 shrink-0 text-muted" />
      <span class="flex-1 text-left truncate">{l("Edit")}</span>
    </div>
  </:open_btn>
  <:action_btns>
    <button type="submit" class="normal-case btn-sm btn btn-primary">
      {l("Done")}
    </button>
  </:action_btns>
</Bonfire.UI.Common.OpenModalLive>
