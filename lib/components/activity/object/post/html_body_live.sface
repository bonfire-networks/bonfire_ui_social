<div
  id={deterministic_dom_id(
    __MODULE__,
    id(@activity) || id(@object) || "no-id",
    "expandable_note",
    @parent_id
  )}
  data-ref={deterministic_dom_id(__MODULE__, id(@activity) || id(@object) || "no-id", "note_ref", @parent_id)}
  data-id="object_body"
  data-role="html_body"
  data-inception={@activity_inception}
  data-rendered={@showing_within}
  data-main-object={@viewing_main_object}
  class={
    "object_body prose-bonfire translatable prose break-normal max-w-none text-base-content prose-hr:!my-2 prose-br:hidden prose-a:font-normal",
    previewable_truncate:
      !@viewing_main_object &&
        @showing_within not in [:smart_input, :pinned],
    # microblog posts read as one block: paragraph breaks cost ~half a line, not article-style margins
    "prose-p:!my-1": e(@object_type, nil) != :article,
    # The main post anchors the discussion and should stand apart from replies.
    "!text-[20px] !leading-[1.5]": @viewing_main_object && @showing_within == :thread,
    "!text-sm !text-muted": e(@object_type, nil) == :article && @showing_within != :thread
  }
>
  {rich(
    @html_body,
    # remote content is stored in HTML, but local content may contain markdown and/or HTML
    skip_markdown: @is_remote,
    #  we want to sanitize rather than escape HTML in local content
    sanitize: !@is_remote
  )}
</div>