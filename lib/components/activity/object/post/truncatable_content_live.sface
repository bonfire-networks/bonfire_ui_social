{!-- the clamp, its hook and the Read more buttons are shared with bios and group descriptions; the post's own body sets the clamp class, so it is shown whole on its own page --}
<Bonfire.UI.Common.TruncatableLive
  id={deterministic_dom_id(
    __MODULE__,
    id(@activity) || id(@object) || "no-id",
    "truncation_detector",
    @parent_id
  )}
  read_more={@showing_within not in [:smart_input, :pinned]}
>
  <Bonfire.UI.Social.Activity.HtmlBodyLive
    html_body={@html_body}
    activity={@activity}
    object={@object}
    parent_id={deterministic_dom_id(__MODULE__, nil, nil, @parent_id)}
    object_type={@object_type}
    showing_within={@showing_within}
    viewing_main_object={@viewing_main_object}
    activity_inception={@activity_inception}
  />
</Bonfire.UI.Common.TruncatableLive>
