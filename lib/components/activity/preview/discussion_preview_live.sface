<a
  href={@permalink || "#"}
  target={e(@__context__, :link_target, nil) || "_top"}
  rel={if e(@__context__, :link_target, nil) == "_blank", do: "noopener"}
  data-role="trending-discussion-link"
  aria-labelledby={"dp_#{@activity_component_id || id(@activity)}_rank dp_#{@activity_component_id || id(@activity)}_author dp_#{@activity_component_id || id(@activity)}_excerpt dp_#{@activity_component_id || id(@activity)}_replies"}
  class="preview_activity_link group grid min-h-[7.5rem] grid-cols-[2rem_2.75rem_minmax(0,1fr)] gap-x-3 gap-y-2 px-4 py-4 no-underline transition-colors hover:bg-base-content/[0.035] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary sm:grid-cols-[2.5rem_3rem_minmax(0,1fr)] sm:px-5 sm:py-5"
>
  <div class="row-span-3 pt-0.5 text-center">
    <span id={"dp_#{@activity_component_id || id(@activity)}_rank"} class="sr-only">
      {l("Rank %{rank}", rank: @rank)}
    </span>
    <span
      aria-hidden="true"
      data-role="trending-discussion-rank"
      class={[
        "text-lg font-semibold tabular-nums tracking-tight sm:text-xl",
        "text-primary": !@rank || @rank <= 3,
        "text-muted": @rank && @rank > 3
      ]}
    >
      {String.pad_leading(to_string(@rank || 0), 2, "0")}
    </span>
  </div>

  {#case creator(@activity, @object)}
    {#match nil}
      <div class="row-span-3 flex h-11 w-11 items-center justify-center rounded-full bg-base-content/5 sm:h-12 sm:w-12">
        <#Icon iconify="ph:user-circle-fill" class="h-6 w-6 text-muted" />
      </div>
    {#match author}
      <Bonfire.UI.Common.AvatarLive
        parent_id={"dp_#{@activity_component_id}"}
        user_id={id(author)}
        src={Media.avatar_url(e(author, :profile, nil) || author)}
        title={creator_name(@activity, @object) || l("Someone")}
        showing_within={:widget}
        wrapper_class="row-span-3 h-11 w-11 border-0 avatar !flex sm:h-12 sm:w-12"
        class="h-11 w-11 rounded-full bg-base-100 sm:h-12 sm:w-12"
        bg_class="h-full w-full overflow-hidden rounded-full"
      />
  {/case}

  <div class="min-w-0 self-center">
    <div class="flex min-w-0 items-baseline gap-1.5">
      <span
        id={"dp_#{@activity_component_id || id(@activity)}_author"}
        class="truncate text-sm font-semibold text-base-content sm:text-base"
      >
        {creator_name(@activity, @object) || l("Someone")}
      </span>
      <span :if={@date_ago} class="shrink-0 text-xs text-muted sm:text-sm">· {@date_ago}</span>
    </div>
  </div>

  <p
    id={"dp_#{@activity_component_id || id(@activity)}_excerpt"}
    class="col-start-3 line-clamp-2 min-w-0 text-sm leading-5 text-base-content/80 sm:text-[0.95rem] sm:leading-6"
  >
    {excerpt(@activity, @object, @cw) || l("Sensitive content")}
  </p>

  <div class="col-start-3 flex min-w-0 flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-0.5 text-xs text-muted sm:text-sm">
    <span
      id={"dp_#{@activity_component_id || id(@activity)}_replies"}
      class="flex items-center gap-1.5"
    >
      <#Icon iconify="ph:chat-circle" class="h-4 w-4" />
      {#case display_reply_count(@activity, @reply_count)}
        {#match 1}
          <span>{l("1 reply")}</span>
        {#match count}
          <span>{l("%{count} replies", count: count)}</span>
      {/case}
    </span>

    <span
      :if={@participants != [] || @participants_more_count > 0}
      data-role="thread_participants"
      class="flex min-w-0 items-center gap-2"
      title={if @participants != [],
        do:
          l("Also in this discussion: %{names}",
            names: Bonfire.Social.Threads.participants_names(@participants, ", ")
          )}
    >
      <span :if={@participants != []} class="flex shrink-0 -space-x-1.5">
        {#for participant <- @participants}
          <Bonfire.UI.Common.AvatarLive
            parent_id={deterministic_dom_id(
              __MODULE__,
              id(participant),
              "trending_participant",
              id(@activity)
            )}
            user_id={id(participant)}
            src={Media.avatar_url(participant)}
            title={e(participant, :profile, :name, nil) ||
              e(participant, :character, :username, nil)}
            showing_within={:widget}
            wrapper_class="h-6 w-6 border-0 avatar !flex"
            class="h-6 w-6 rounded-full bg-base-100 ring-2 ring-base-100"
            bg_class="h-full w-full overflow-hidden rounded-full"
          />
        {/for}
      </span>
      <span :if={@participants_more_count == 1}>{l("1 other")}</span>
      <span :if={@participants_more_count > 1}>
        {l("%{count} others", count: @participants_more_count)}
      </span>
    </span>
  </div>
</a>
