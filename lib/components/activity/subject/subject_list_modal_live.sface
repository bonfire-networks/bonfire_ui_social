<Bonfire.UI.Common.OpenModalLive
  :if={reaction_for(@experienced_as)}
  id={@id}
  title_text={title_for(@experienced_as)}
  open_modal_wrapper_class="contents"
  open_btn_wrapper_class={["!w-auto", @trigger_class]}
  no_actions
  modal_assigns={[
    modal_component: Bonfire.UI.Reactions.ReactionListLive,
    modal_component_stateful?: true,
    reaction: reaction_for(@experienced_as),
    object_id: @object_id
  ]}
>
  <:open_btn><span data-role="open_subject_list">{@trigger_text}</span></:open_btn>
</Bonfire.UI.Common.OpenModalLive>
<span :if={!reaction_for(@experienced_as)}>{@trigger_text}</span>
