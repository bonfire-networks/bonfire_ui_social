<span :if={not email_about_reader?(assigns)} class="muted" style="font-size: 13px;">
  {email_name(assigns)} @{email_username(assigns)} · {Bonfire.Common.DatesTimes.format_date(
    Bonfire.Common.DatesTimes.date_from_pointer(assigns[:object])
  )}<span :if={assigns[:thread_title]}>: {assigns[:thread_title]}</span>
</span>
