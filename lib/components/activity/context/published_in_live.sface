<div
  data-role={if @placement == :author, do: "author_group", else: "published_in"}
  data-publication-context={@placement}
  class={case @placement do
    :author ->
      "hidden"

    :attribution ->
      "inline-flex items-baseline gap-1 min-w-0 max-w-full text-base leading-snug align-baseline"

    :standalone ->
      @class
  end}
>
  {#if @placement == :author}
    <span class="text-muted">{l("in")}</span>
    <LinkLive
      opts={"data-role": "published_in_pill"}
      class="inline-flex items-center gap-1.5 min-w-0 max-w-full rounded-full bg-fill hover:bg-fill-strong py-0.5 pl-0.5 pr-2.5 text-base-content transition-colors"
      to={@to}
    >
      {!-- same identity tile as the groups sidebar: avatar, else a hued letter --}
      {#case context_icon_url(@context)}
        {#match nil}
          <span
            data-role="group_tile"
            class="nav-tile"
            style={"--tile-hue: #{context_tile_hue(@context)}"}
            aria-hidden="true"
          >{context_initial(@context)}</span>
        {#match icon_url}
          <img
            src={icon_url}
            alt=""
            loading="lazy"
            class="size-5 shrink-0 rounded-[5px] object-cover outline outline-1 -outline-offset-1 outline-base-content/10"
          />
      {/case}
      <span data-role="group_name" class="truncate">{context_label(@context)}</span>
    </LinkLive>
  {#else}
    <span :if={@placement == :attribution} aria-hidden="true" class="mx-1 text-muted">·</span>
    {#if @placement == :standalone}
      {#case context_icon_url(@context)}
        {#match nil}
          <#Icon iconify="ph:users-three-fill" class="size-5 text-primary" />
        {#match icon_url}
          <img src={icon_url} alt="" loading="lazy" class="size-5 shrink-0 rounded-full object-cover">
      {/case}
    {/if}
    <span class={"flex-1 text-sm text-muted": @placement == :standalone}>
      <span class="text-muted">{l("Posted in")}</span>
      <LinkLive
        class={[
          "link link-hover font-medium text-primary",
          "truncate max-w-40": @placement == :attribution
        ]}
        to={@to}
      >
        {context_label(@context)}
      </LinkLive>
    </span>
  {/if}
</div>
