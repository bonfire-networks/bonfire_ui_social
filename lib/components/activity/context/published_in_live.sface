{!-- Something published in a Category / Topic --}
{#if @compact}
  {!-- The separator lives inside this node rather than at the call site, so presets hiding the whole chip (see `[data-role="boosted_by"] [data-role="published_in"]` in stream.css) don't strand a "·". --}
  <div
    data-role="published_in"
    class="inline-flex items-baseline gap-1 min-w-0 max-w-full text-body leading-snug align-baseline"
  >
    <span aria-hidden="true" class="mx-1 text-muted">·</span>
    <span class="text-muted">{l("Posted in")}</span>
    <LinkLive class="link link-hover text-primary truncate max-w-[160px]" to={@to}>
      {context_label(@context)}
    </LinkLive>
  </div>
{#else}
  <div data-role="published_in" class={@class}>
    <#Icon iconify="ph:users-three-fill" class="w-5 h-5 text-primary" />
    <div class="flex-1">
      <div class="text-sm text-muted">
        {l("Posted in")}
        <LinkLive class="font-medium text-primary" to={@to}>
          {context_label(@context)}
        </LinkLive>
      </div>
    </div>
  </div>
{/if}
