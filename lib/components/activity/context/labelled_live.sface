<div data-type={@label_id} class="border-hair mt-3 rounded-box border-divider">
  <!-- :if={@showing_within not in [:group, :topic, :thread] and not is_nil(@label)} -->
  <div class="bg-fill rounded-t-box border-b-hair border-divider flex items-center gap-3 py-2 p-3">
    {#case @label_id || id(@label)}
      {#match "1ABE10VTDATEDGET1ATESTNEWS"}
        <#Icon iconify="ri:broadcast-fill" class="size-5 text-primary" />
      {#match "1ABE1M1S1NF0RMEDGETZEFACTS"}
        <#Icon iconify="material-symbols:local-library-rounded" class="size-5 text-warning" />
      {#match "1ABE1M1S1EAD1NGBACK2S0VRCE"}
        <#Icon iconify="ooui:error" class="size-5 text-error" />
      {#match _}
        <#Icon iconify="material-symbols:local-library-rounded" class="size-5 text-warning" />
    {/case}

    <div class="font-medium text-base-content">
      {e(@label, :profile, :name, nil) || e(@label, :character, :username, nil)}
    </div>
  </div>
</div>