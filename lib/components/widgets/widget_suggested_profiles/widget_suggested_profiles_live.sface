{#case list_suggested_profiles()}
  {#match suggested_profiles}
    <Bonfire.UI.Common.WidgetBlockLive
      :if={current_user_id(@__context__)}
      widget_title={e(@widget_title, l("Who to follow"))}
      reset_cache_event="Bonfire.UI.Social.WidgetSuggestedProfilesLive:reset_suggested_profiles"
      empty={suggested_profiles == []}
      empty_icon="ph:user-plus-fill"
      empty_message={l("No suggestions yet")}
    >
      {!-- three rows with Follow, as the people widgets, so it reads as a short list in either column --}
      <div class="widget-rows" data-role="widget-body" data-id="suggested-profiles">
        {#for user <- Enum.take(suggested_profiles, 3)}
          {!-- the list is cached for everyone, so whoever this viewer silenced is dropped here --}
          <StatefulComponent
            module={maybe_component(Bonfire.UI.Boundaries.IfCan, @__context__)}
            id={"suggested_profile_if_can_#{id(user)}"}
            object={user}
            check_object_boundary={current_user_id(@__context__) && [:see]}
          >
            <div class="widget-row" data-role="suggested-profile-row">
              <StatelessComponent
                module={maybe_component(Bonfire.UI.Me.ProfileItemLive)}
                showing_within={:widget_row}
                parent_id={"suggested_profiles_#{id(user)}"}
                character={e(user, :character, nil)}
                profile={e(user, :profile, nil)}
              />
              <StatefulComponent
                :if={current_user_id(@__context__) != id(user)}
                module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
                id={ComponentID.new(Bonfire.UI.Social.Graph.FollowButtonLive, id(user), "suggested_profiles")}
                object_id={id(user)}
                object={user}
                path={path(user)}
                with_bell={false}
                container_class="flex shrink-0"
                hide_icon
                class="btn btn-sm widget-action widget-action-outline"
                class_already="btn btn-sm widget-action widget-action-quiet"
              />
            </div>
          </StatefulComponent>
        {/for}
      </div>
    </Bonfire.UI.Common.WidgetBlockLive>
{/case}
