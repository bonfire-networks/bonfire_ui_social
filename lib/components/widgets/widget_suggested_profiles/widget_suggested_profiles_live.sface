{#case list_suggested_profiles()}
  {#match suggested_profiles}
    <Bonfire.UI.Common.WidgetBlockLive
      :if={current_user_id(@__context__)}
      class="w-full pt-4 flex-auto mx-auto border-y-hair border-secondary overflow-hidden px-card"
      title_class="flex items-center justify-between pb-card text-xs font-normal uppercase tracking-wide text-base-content"
      widget_title={e(@widget_title, l("Who to follow"))}
      reset_cache_event="Bonfire.UI.Social.WidgetSuggestedProfilesLive:reset_suggested_profiles"
      empty={suggested_profiles == []}
      empty_icon="ph:user-plus-fill"
      empty_message={l("No suggestions yet")}
    >
      {!-- Carousel navigation arrows, shown in the header to the right of the title --}
      <:action :if={length(suggested_profiles) > 1}>
        <div class="flex items-center gap-1.5">
          <.icon_button
            icon="ph:caret-left"
            aria_label={l("Scroll left")}
            variant="outline"
            size="sm"
            class="border-secondary"
            phx_click={JS.dispatch("scroll-left", to: "#suggested-profiles-carousel")}
          />
          <.icon_button
            icon="ph:caret-right"
            aria_label={l("Scroll right")}
            variant="outline"
            size="sm"
            class="border-secondary"
            phx_click={JS.dispatch("scroll-right", to: "#suggested-profiles-carousel")}
          />
        </div>
      </:action>

      <div class="grid grid-cols-1 overflow-hidden">
        <div id="suggested-profiles-carousel" class="carousel-scroll pb-2" phx-hook="CarouselScroll">
          {#for user <- suggested_profiles}
            <div class="rounded-box bg-base-200 overflow-hidden" style="width: calc(80% - 8px);">
              <StatelessComponent
                module={maybe_component(Bonfire.UI.Me.ProfileItemLive)}
                character={e(user, :character, nil) || e(user, :activity, :subject, :character, nil)}
                profile={e(user, :profile, nil) || e(user, :activity, :subject, :profile, nil)}
                show_summary
                show_controls={[:follow]}
              />
              {!-- <StatelessComponent
                module={maybe_component(Bonfire.UI.Me.UserPreviewLive, @__context__)}
                user={user}
                href={"/@#{e(user, :character, :username, "")}"}
                with_banner
                parent_id={deterministic_dom_id(__MODULE__, id(user), "widget_suggested", nil)}
              >
                <:actions>
                  <div class="px-3 pb-3">
                    <StatefulComponent
                      :if={current_user_id(@__context__)}
                      module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
                      id={ComponentID.new(Bonfire.UI.Social.Graph.FollowButtonLive, id(user), "widget_suggested_profiles")}
                      object_id={id(user)}
                    />
                  </div>
                </:actions>
              </StatelessComponent> --}
            </div>
          {/for}
        </div>
      </div>
    </Bonfire.UI.Common.WidgetBlockLive>
{/case}
