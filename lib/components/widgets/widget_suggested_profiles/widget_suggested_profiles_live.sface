{#case list_suggested_profiles()}
  {#match suggested_profiles}
    <Bonfire.UI.Common.WidgetBlockLive
      :if={current_user_id(@__context__)}
      class="w-full pt-4 flex-auto mx-auto border-y-hair border-divider overflow-hidden px-card"
      title_class="flex items-center justify-between pb-card text-xs font-normal uppercase tracking-wide text-base-content"
      widget_title={e(@widget_title, l("Who to follow"))}
      reset_cache_event="Bonfire.UI.Social.WidgetSuggestedProfilesLive:reset_suggested_profiles"
      empty={suggested_profiles == []}
      empty_icon="ph:user-plus-fill"
      empty_message={l("No suggestions yet")}
    >
      <:action>
        <Bonfire.UI.Common.CarouselArrowsLive
          track="suggested-profiles-carousel"
          count={length(suggested_profiles)}
        />
      </:action>

      <Bonfire.UI.Common.CarouselLive
        id="suggested-profiles-carousel"
        items={suggested_profiles}
        visible_items={2}
        class="pb-2"
      >
        <:card :let={item: user}>
          <StatelessComponent
            module={maybe_component(Bonfire.UI.Me.UserPreviewLive, @__context__)}
            user={user}
            href={path(user)}
            with_banner
            with_summary
            show_badges={false}
            stretch_link={false}
            class="h-full"
            parent_id="suggested_profiles"
          >
            <:actions>
              <StatefulComponent
                :if={current_user_id(@__context__) != id(user)}
                module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
                id={ComponentID.new(Bonfire.UI.Social.Graph.FollowButtonLive, id(user), "suggested_profiles")}
                object_id={id(user)}
                object={user}
                path={path(user)}
                with_bell={false}
                container_class="relative z-2 mt-4 flex w-full"
                hide_icon
                class="btn btn-primary btn-sm w-full"
                class_already="btn btn-primary btn-soft btn-sm w-full"
              />
            </:actions>
          </StatelessComponent>
        </:card>
      </Bonfire.UI.Common.CarouselLive>
    </Bonfire.UI.Common.WidgetBlockLive>
{/case}
