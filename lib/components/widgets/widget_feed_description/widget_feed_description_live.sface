<Bonfire.UI.Common.WidgetBlockLive :if={@preset} class="p-card">
  <section id="feed-description" aria-labelledby="feed-description-title">
    <div class="flex items-center gap-3">
      <span
        class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary"
        aria-hidden="true"
      >
        <Iconify.iconify icon={e(@preset, :icon, "ph:rss-duotone")} class="size-6" />
      </span>
      <h2
        id="feed-description-title"
        class="min-w-0 flex-1 text-lg font-semibold leading-6 break-words truncate"
      >
        {Bonfire.UI.Social.FeedNavigation.get_name(@preset, @feed_name)}
      </h2>
      <span
        :if={@can_set_default? and @feed_name not in [:notifications, "notifications"]}
        class="tooltip tooltip-left"
        data-tip={@default_label}
      >
        <button
          id="feed-description-default"
          type="button"
          phx-click="Bonfire.Social.Feeds:preset_set_default"
          phx-value-id={@feed_name}
          disabled={@default?}
          aria-label={@default_label}
          class={[
            "btn btn-ghost btn-square btn-sm shrink-0 rounded-lg p-0",
            "disabled:text-primary disabled:bg-transparent": @default?,
            "text-muted": !@default?
          ]}
        >
          {#if @default?}
            <#Icon iconify="ph:house-fill" class="size-4" />
          {#else}
            <#Icon iconify="ph:house" class="size-4" />
          {/if}
          <span class="sr-only">{@default_label}</span>
        </button>
      </span>
      <Bonfire.UI.Social.FeedPinButtonLive
        :if={current_user(@__context__) && @feed_name not in [:notifications, "notifications"] &&
          !Settings.get([:ui, :sidebar, :disable_feeds_customization], false, :instance)}
        id="feed-description-pin"
        feed_name={@feed_name}
        pinned={@pinned}
      />
    </div>
    <p :if={e(@preset, :description, nil)} class="mt-3 text-sm leading-relaxed text-muted">
      {e(@preset, :description, nil)}
    </p>
  </section>
</Bonfire.UI.Common.WidgetBlockLive>
