{#if @boxed}
  <Bonfire.UI.Common.WidgetBlockLive :if={@preset}>
    <section id="feed-description" aria-labelledby="feed-description-title">
      <h2 id="feed-description-title" class="text-base font-bold leading-6 break-words">
        {Bonfire.UI.Social.FeedNavigation.get_name(@preset, @feed_name)}
      </h2>
      <p :if={e(@preset, :description, nil)} class="mt-2 text-sm leading-relaxed text-muted">
        {e(@preset, :description, nil)}
      </p>
    </section>
  </Bonfire.UI.Common.WidgetBlockLive>
{#else}
  <section :if={@preset} id="feed-description" aria-labelledby="feed-description-title">
    <div class="px-4.5 pt-3.5 pb-3">
      <h2
        id="feed-description-title"
        class="flex items-center gap-2 text-sm font-bold leading-5 break-words text-base-content"
      >
        <span aria-hidden="true" class="flex shrink-0 items-center text-primary">
          <Iconify.iconify icon={e(@preset, :icon, "ph:rss-simple")} class="size-[18px]" />
        </span>
        <span class="min-w-0">{Bonfire.UI.Social.FeedNavigation.get_name(@preset, @feed_name)}</span>
      </h2>
      <p
        :if={e(@preset, :description, nil)}
        class="mt-1 text-sm leading-relaxed text-muted text-pretty break-words"
      >
        {e(@preset, :description, nil)}
      </p>
    </div>
    <div
      :if={current_user(@__context__)}
      class="flex flex-col border-t border-divider p-1.5"
    >
      <button
        :if={@can_set_default? and @feed_name not in [:notifications, "notifications"]}
        id="feed-description-default"
        type="button"
        phx-click="Bonfire.Social.Feeds:preset_set_default"
        phx-value-id={@feed_name}
        disabled={@default?}
        class={@row_class}
      >
        {#if @default?}
          <#Icon iconify="ph:house-fill" class="size-[18px] shrink-0 text-primary" />
        {#else}
          <#Icon iconify="ph:house" class="size-[18px] shrink-0 text-muted" />
        {/if}
        <span>{@default_label}</span>
        <#Icon :if={@default?} iconify="ph:check" class="ml-auto size-4 shrink-0 text-primary" />
      </button>
      <Bonfire.UI.Social.FeedPinButtonLive
        :if={@feed_name not in [:notifications, "notifications"] &&
          !Settings.get([:ui, :sidebar, :disable_feeds_customization], false, :instance)}
        id="feed-description-pin"
        feed_name={@feed_name}
        pinned={@pinned}
        show_label
        class={@row_class}
        icon_class="size-[18px]"
      />
      <LinkLive
        to={~p"/settings/user/feeds"}
        opts={[id: "feed-description-settings"]}
        class={@row_class}
      >
        <#Icon iconify="ph:gear-six" class="size-[18px] shrink-0 text-muted" />
        <span>{l("Feed settings")}</span>
        <#Icon iconify="ph:arrow-right" class="ml-auto size-4 shrink-0 text-muted" />
      </LinkLive>
    </div>
  </section>
{/if}
