<Bonfire.UI.Common.WidgetBlockLive
  :if={@presets != []}
  widget_title={e(@widget_title, l("Feeds"))}
>
  {!-- slot entries don't support `:if` in Surface (only `:let`), so the gate goes inside --}
  <:action>
    <LinkLive
      :if={!Bonfire.Common.Settings.get([:ui, :sidebar, :disable_feeds_customization], false, :instance)}
      to={~p"/settings/user/feeds"}
      label={l("Customize feeds")}
      class="tooltip-button btn btn-circle btn-outline border-primary btn-xs"
      data-tip={l("Customize feeds")}
    >
      <#Icon iconify="ph:gear-six-fill" class="w-4 h-4 text-primary" />
    </LinkLive>
  </:action>
  {!--  --}
  <ul class="flex flex-col divide-hair border-t-hair border-divider divide-divider">
    {#for preset <- @presets}
      <li class="p-1">
        <LinkLive
          to={preset[:href]}
          class={[
            "group inline-flex items-center gap-3 bg-base-100 w-full px-2 py-1.5 rounded-box border-hair border-divider text-secondary",
            "bg-primary/20": preset[:selected?],
            "hover:bg-fill": !preset[:selected?]
          ]}
          label={preset[:name] || preset[:text] || preset[:description]}
        >
          <Iconify.iconify icon={preset[:icon]} class="size-4 text-primary" />
          <span class="text-sm truncate text-primary font-medium">
            {localise_dynamic(
              preset[:name] || preset[:text] || preset[:description],
              preset[:extension] || preset[:module] || __MODULE__
            )}
          </span>
        </LinkLive>
      </li>
    {/for}
  </ul>
</Bonfire.UI.Common.WidgetBlockLive>
