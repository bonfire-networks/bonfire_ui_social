{#case load(current_user(@__context__), @limit)}
  {#match discussions}
    <div data-id="trending_discussions_widget">
      <Bonfire.UI.Common.WidgetBlockLive
        class="w-full relative overflow-hidden"
        widget_title={@widget_title || l("Top discussions")}
        reset_cache_event="Bonfire.UI.Social.WidgetTrendingDiscussionsLive:reset_trending_discussions"
        reset_cache_values={%{limit: @limit}}
        empty={discussions == []}
        empty_icon="ph:chats-circle-fill"
        empty_message={l("No popular discussions yet. Why not start one? Your post could be tomorrow's top thread.")}
      >
        <:action>
          <div class="flex items-center gap-3">
            <LinkLive
              to={~p"/feed/trending_discussions"}
              class="text-xs font-medium text-muted hover:text-primary"
              aria-label={l("View all top discussions")}
            >
              {l("View all")}
            </LinkLive>
            {!-- data attributes handled by scroll.js, so they work without a socket --}
            <div :if={length(discussions) > 1} class="flex items-center gap-1.5">
              <.icon_button
                icon="carbon:chevron-left"
                aria_label={l("Scroll left")}
                variant="outline"
                size="sm"
                class="border-transparent bg-transparent text-muted hover:text-base-content"
                data-carousel-scroll="previous"
                aria-controls="trending-discussions-carousel"
              />
              <.icon_button
                icon="carbon:chevron-right"
                aria_label={l("Scroll right")}
                variant="outline"
                size="sm"
                class="border-transparent bg-transparent text-muted hover:text-base-content"
                data-carousel-scroll="next"
                aria-controls="trending-discussions-carousel"
              />
            </div>
          </div>
        </:action>

        <div class="grid grid-cols-1 overflow-hidden relative">
          <div
            id="trending-discussions-carousel"
            class="carousel-scroll items-start"
            phx-hook="CarouselScroll"
            role="list"
            data-id="trending_discussions"
          >
            {#for fp <- discussions}
              <div
                id={"trending_discussion_#{id(fp.activity) || id(fp.activity.object)}"}
                role="listitem"
                class="spotlight_clamp w-[var(--carousel-item-w-mobile)] sm:w-[var(--carousel-item-w)] rounded-box bg-base-100 p-card"
                style={"--carousel-item-w-mobile: #{carousel_item_width(:peek)}; --carousel-item-w: #{carousel_item_width(nil)};"}
              >
                <Bonfire.UI.Social.ActivityLive
                  id={Bonfire.UI.Social.ActivityLive.component_id(
                    id(fp.activity) || id(fp.activity.object),
                    "trending_discussion"
                  )}
                  activity={fp.activity}
                  class="flex-1 spotlight_activity"
                  showing_within={:widget}
                  custom_actions={Bonfire.UI.Social.Activity.DiscussionPreviewActionsLive}
                  participants={e(fp, :participants, [])}
                  participants_more_count={e(fp, :participants_more_count, 0)}
                />
              </div>
            {/for}
          </div>
        </div>
      </Bonfire.UI.Common.WidgetBlockLive>
    </div>
{/case}
