{#case @category}
  {#match %{id: _} = category}
    <div data-role="thread_context">
      <Bonfire.UI.Common.WidgetBlockLive widget_title={eyebrow(category)}>
        <LinkLive
          to={path(category)}
          class="group block focus:outline-none"
          data-role="thread_context_link"
          aria-label={"#{eyebrow(category)}: #{category_name(category)}"}
        >
          <div class="flex items-center gap-2 min-w-0">
            {#case Media.avatar_url(category)}
              {#match "/images/avatar.png"}
                <Iconify.iconify icon={icon(category)} class="size-5 shrink-0 text-primary/70" />
              {#match url}
                <img src={url} alt="" class="size-5 shrink-0 rounded-md object-cover">
            {/case}

            <span class="font-medium text-base text-base-content leading-tight truncate motion-safe:transition-colors motion-safe:duration-150 group-hover:text-primary group-focus-visible:text-primary">
              {category_name(category)}
            </span>
          </div>

          {!-- was: the summary as raw text inside this link, clamped to 2 lines (markdown shown literally, no way to expand). It is now below the link, since a Read more button can't sit inside an <a> without also following it
          <p
            :if={e(category, :profile, :summary, "") != ""}
            class="mt-1 text-sm text-muted leading-snug line-clamp-2"
          >{e(category, :profile, :summary, "")}</p>
          --}

          {#case e(category, :type, nil)}
            {#match :group}
              <p class="mt-1.5 text-xs text-subtle">
                {members_count(category)} {l("members")}
              </p>
            {#match _}
          {/case}
        </LinkLive>

        {!-- same clamp and Read more as the group hero's description (group_hero_live.sface) --}
        {#case e(category, :profile, :summary, nil)}
          {#match summary when summary in [nil, ""]}
          {#match summary}
            <Bonfire.UI.Common.TruncatableLive
              id={"thread-context-summary-#{id(category)}"}
              html={rich(summary)}
              class="mt-2 prose prose-sm text-muted max-w-none [&>p:first-child]:mt-0 [&>p:last-child]:mb-0"
            />
        {/case}
      </Bonfire.UI.Common.WidgetBlockLive>
    </div>
  {#match _}
{/case}
