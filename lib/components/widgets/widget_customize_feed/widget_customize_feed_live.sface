<div id={@id} data-role="feed_preferences_widget">
  <Bonfire.UI.Common.WidgetBlockLive widget_title={@widget_title || l("Feed preferences")}>
    <:action>
      <button
        id={"feed_reset_#{@feed_name}"}
        type="button"
        class="btn btn-ghost btn-square !btn-sm tooltip tooltip-left text-muted"
        data-tip={l("Reset")}
        data-role="feed_preferences_reset"
        aria-label={l("Reset feed preferences")}
        phx-click="reset_preferences"
        phx-target={@myself}
      >
        <#Icon iconify="ph:arrow-counter-clockwise" class="size-4" />
      </button>
    </:action>
    <div class="flex flex-col gap-0" data-id="widget_customize_feed">
      <form
        id={"feed_order_form_#{@feed_name || "default"}"}
        class="flex items-center justify-between gap-3"
        data-role="feed_order_row"
        phx-change="set_feed_order"
        phx-target={@event_target}
      >
        <label
          for={"feed_order_#{@feed_name || "default"}"}
          class="text-sm font-normal text-muted"
        >{l("Sort")}</label>
        <select
          id={"feed_order_#{@feed_name || "default"}"}
          name="feed_order"
          class="min-h-11 min-w-0 max-w-[70%] cursor-pointer appearance-none truncate border-0 bg-transparent p-0 text-right text-sm text-base-content underline decoration-base-content/30 underline-offset-4 transition-colors duration-150 ease-out hover:decoration-base-content focus-ring rounded-selector"
        >
          {#for {value, label} <- Bonfire.UI.Social.WidgetCustomizeFeedLive.order_options()}
            <option
              value={value}
              selected={Bonfire.UI.Social.WidgetCustomizeFeedLive.current_order(@feed_filters) == value}
            >{label}</option>
          {/for}
        </select>
      </form>
      <fieldset class="min-w-0">
        <legend class="sr-only">{l("Include")}</legend>
        <Bonfire.UI.Common.Settings.Calm.OverrideTogglesLive
          scope={nil}
          event_name="set_filter_overrides"
          event_mode={:click}
          event_target={@event_target}
          form_name="feed_overrides"
          form_id={"feed_overrides_form_#{@feed_name || "default"}"}
          form_role="feed_override_toggles"
          form_class="flex flex-col gap-0"
          row_class="min-h-11 -mx-2 rounded-selector px-2 transition-colors duration-150 ease-out hover:bg-fill active:bg-fill-strong"
          name_class="text-sm font-normal text-muted"
          rows={Bonfire.UI.Social.WidgetCustomizeFeedLive.override_rows(@feed_filters)}
          field_prefix="scope"
          toggle_role="feed_override_toggle"
        />
      </fieldset>
      <div
        class="mt-1.5 flex flex-wrap items-center gap-x-3 border-t border-divider pt-1"
        data-role="feed_advanced_filters_wrapper"
      >
        {!-- Both actions share one line. The expander's wrappers are `contents`, so its toggle stays on that
             line and only its expanded editor (`basis-full`) wraps onto a full-width line below; an opened
             save form takes the full width the same way. --}
        <div
          :if={current_user(@__context__) && @default_preferences &&
            preferences_changed?(@feed_filters, @default_preferences)}
          class="min-w-0 has-[details[open]]:basis-full"
        >
          <Bonfire.UI.Social.SaveFeedPresetLive
            id={"#{@id}_save_custom_feed"}
            event_target={@event_target}
            show_icon={false}
            summary_class="-ml-2 flex min-h-11 cursor-pointer items-center whitespace-nowrap rounded-selector px-2 text-sm font-medium text-primary transition-colors duration-150 ease-out hover:bg-primary/5 motion-reduce:transition-none focus-ring"
          />
        </div>
        <Bonfire.UI.Common.OpenExpanderLive
          parent_id={"feed_filters_#{@feed_name}"}
          modal_assigns={Bonfire.UI.Social.FeedControlsLive.feed_filters_modal_assigns(assigns)}
          open_modal_wrapper_class="contents"
          open_btn_wrapper_class="!w-auto ml-auto -mr-2 block rounded-selector focus-ring"
          expander_wrapper_class="basis-full"
          open_btn_class="flex min-h-11 cursor-pointer items-center whitespace-nowrap rounded-selector px-2 text-sm text-muted transition-colors duration-150 ease-out hover:bg-fill hover:text-base-content motion-reduce:transition-none"
          caret_class="hidden"
        >
          {!-- no caret: the label itself says which way the toggle goes --}
          <:open_btn :let={show: show}>
            <span data-role="feed_advanced_filters">{if show, do: l("Hide filters"), else: l("More filters")}</span>
          </:open_btn>
          <:default>
            <StatefulComponent
              id={"feed_preferences_details_#{@feed_name}"}
              module={Bonfire.UI.Social.FeedFiltersModalContentLive}
              show_reset={false}
              sections={Bonfire.UI.Social.FeedFiltersModalContentLive.sections() -- [:sort_order, :save_preset]}
              {...Bonfire.UI.Social.FeedControlsLive.feed_filters_modal_assigns(assigns)}
            />
          </:default>
        </Bonfire.UI.Common.OpenExpanderLive>
      </div>
    </div>
  </Bonfire.UI.Common.WidgetBlockLive>
</div>
