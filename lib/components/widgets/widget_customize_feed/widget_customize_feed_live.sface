<div id={@id} class="bg-[var(--stream-surface)] rounded-box" data-role="feed_preferences_widget">
  <Bonfire.UI.Common.WidgetBlockLive
    widget_title={@widget_title || l("Feed preferences")}
    title_class="flex min-h-11 mb-0.5 items-center justify-between text-base font-semibold text-base-content"
    class="w-full flex-auto mx-auto px-4 py-3 border-y-hair border-secondary"
  >
    <:action>
      <button
        id={"feed_reset_#{@feed_name}"}
        type="button"
        class="btn btn-ghost btn-square !btn-sm tooltip tooltip-left text-(--stream-text-secondary)"
        data-tip={l("Reset")}
        data-role="feed_preferences_reset"
        aria-label={l("Reset feed preferences")}
        phx-click="reset_preferences"
        phx-target={@myself}
      >
        <#Icon iconify="ph:arrow-counter-clockwise" class="size-4" />
      </button>
    </:action>
    <div class="flex flex-col gap-0" data-id="widget_customize_feed">
      <form
        id={"feed_order_form_#{@feed_name || "default"}"}
        class="flex items-center justify-between gap-3"
        data-role="feed_order_row"
        phx-change="set_feed_order"
        phx-target={@event_target}
      >
        <label
          for={"feed_order_#{@feed_name || "default"}"}
          class="text-sm font-normal text-(--stream-text-secondary)"
        >{l("Sort")}</label>
        <select
          id={"feed_order_#{@feed_name || "default"}"}
          name="feed_order"
          class="select select-md min-h-11 focus-ring h-auto w-auto min-w-0 max-w-[70%]"
        >
          {#for {value, label} <- Bonfire.UI.Social.WidgetCustomizeFeedLive.order_options()}
            <option
              value={value}
              selected={Bonfire.UI.Social.WidgetCustomizeFeedLive.current_order(@feed_filters) == value}
            >{label}</option>
          {/for}
        </select>
      </form>
      <fieldset class="min-w-0">
        <legend class="sr-only">{l("Include")}</legend>
        <Bonfire.UI.Common.Settings.Calm.OverrideTogglesLive
          scope={nil}
          event_name="set_filter_overrides"
          event_mode={:click}
          event_target={@event_target}
          form_name="feed_overrides"
          form_id={"feed_overrides_form_#{@feed_name || "default"}"}
          form_role="feed_override_toggles"
          form_class="flex flex-col gap-0"
          row_class="min-h-11 -mx-2 rounded-selector px-2 transition-colors duration-150 ease-out hover:bg-base-content/5 active:bg-base-content/10"
          name_class="text-sm font-normal text-(--stream-text-secondary)"
          rows={Bonfire.UI.Social.WidgetCustomizeFeedLive.override_rows(@feed_filters)}
          field_prefix="scope"
          toggle_role="feed_override_toggle"
        />
      </fieldset>
      <div
        class="mt-1.5 border-t border-base-content/10 pt-1"
        data-role="feed_advanced_filters_wrapper"
      >
        <Bonfire.UI.Common.OpenExpanderLive
          parent_id={"feed_filters_#{@feed_name}"}
          modal_assigns={Bonfire.UI.Social.FeedControlsLive.feed_filters_modal_assigns(assigns)}
          open_btn_wrapper_class="-mx-2 rounded-selector focus-ring"
          expander_wrapper_class=""
          open_btn_class="min-h-11 w-full px-2 py-1 text-sm font-normal text-base-content/80 flex items-center gap-2 cursor-pointer hover:bg-base-content/5 hover:text-base-content"
          caret_class="size-4 text-base-content/70"
        >
          <:open_btn>
            <span class="flex-1 text-left" data-role="feed_advanced_filters">{l("More filters")}</span>
          </:open_btn>
          <:default>
            <StatefulComponent
              id={"feed_preferences_details_#{@feed_name}"}
              module={Bonfire.UI.Social.FeedFiltersModalContentLive}
              show_reset={false}
              sections={Bonfire.UI.Social.FeedFiltersModalContentLive.sections() -- [:sort_order]}
              {...Bonfire.UI.Social.FeedControlsLive.feed_filters_modal_assigns(assigns)}
            />
          </:default>
        </Bonfire.UI.Common.OpenExpanderLive>
      </div>
    </div>
  </Bonfire.UI.Common.WidgetBlockLive>
</div>
