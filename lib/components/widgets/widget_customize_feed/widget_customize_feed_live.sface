<Bonfire.UI.Common.WidgetBlockLive
  widget_title={@widget_title || l("Customize this feed")}
  title_class="flex items-center justify-between text-base font-semibold text-base-content"
  class="w-full flex-auto mx-auto p-card border-y-hair border-secondary"
>
  <div class="flex flex-col" data-id="widget_customize_feed">
    {!-- Feed preset selector decision: use an anchored popover so the frequent controls stay put. Rejected the full-bleed accordion because its dividers and repeated selected row felt detached from the widget, and the inset disclosure because it still shifted the controls below. --}
    {!-- Level 1 stays compact at rest: the current outcome remains legible and the complete, explained preset list appears only while the user is changing it. --}
    <form
      id={"feed_preset_form_#{@feed_name || "default"}"}
      class="mt-4 border-b-hair border-secondary"
      data-scope="feed_preset"
      phx-change="set_filter_preset"
      phx-target={@event_target}
    >
      <!-- <div class="px-1 text-sm font-normal text-base-content" data-role="feed_preset_title">{l("Feed mode")}</div> -->
      {!-- Matching the current preset walks every bundle's signature, so compute it once per render and reuse it for the trigger and each radio's checked state. --}
      {#case Bonfire.UI.Social.WidgetCustomizeFeedLive.current_preset_card(
          @feed_filters,
          @feed_baseline_filters
        )}
        {#match current_card}
          <Dropdown
            id={"feed_preset_dropdown_#{@feed_name || "default"}"}
            position="bottom-start"
            strategy="fixed"
            match_trigger_width
            focus_on_open="input:checked, input"
            close_on_select
            menu={false}
            wrapper_class="-mx-2"
            trigger_class="group focus-ring flex min-h-14 w-full cursor-pointer items-center gap-2 rounded-selector px-2 py-1.5 text-left text-base-content transition-colors duration-150 ease-out hover:bg-base-content/5 active:bg-base-content/10"
            trigger_opts={["data-role": "feed_preset_current"]}
            panel_class="!p-1.5 max-h-[calc(100dvh-0.625rem)] overflow-y-auto"
          >
            <:trigger>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                <Iconify.iconify icon={current_card.icon} class="size-4" />
              </span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="text-sm font-medium leading-5">
                  {current_card.name}
                </span>
                <span class="truncate text-xs leading-4 text-muted">
                  {current_card.description}
                </span>
              </span>
              <#Icon
                iconify="ph:caret-down"
                class="size-4 shrink-0 text-muted transition-transform duration-150 ease-out group-aria-expanded:rotate-180 motion-reduce:transition-none"
              />
            </:trigger>

            <fieldset id={"feed_preset_options_#{@feed_name || "default"}"}>
              <legend class="sr-only">{l("Feed preset")}</legend>
              <div class="flex flex-col gap-0.5">
                {#for card <- Bonfire.UI.Social.WidgetCustomizeFeedLive.preset_cards()}
                  <label
                    for={"feed_preset_#{@feed_name || "default"}_#{card.value}"}
                    class="relative flex min-h-14 cursor-pointer items-center gap-2 rounded-selector px-2 py-1 has-[:checked]:bg-primary/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-base-content has-[:focus-visible]:ring-inset hover:bg-base-content/5 active:bg-base-content/10"
                    data-role="feed_preset_option"
                  >
                    <input
                      id={"feed_preset_#{@feed_name || "default"}_#{card.value}"}
                      type="radio"
                      name="feed_preset"
                      value={card.value}
                      checked={current_card.value == card.value}
                      class="peer sr-only"
                    />
                    <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-base-content/5 text-muted peer-checked:bg-primary/10 peer-checked:text-primary">
                      <Iconify.iconify icon={card.icon} class="size-3.5" />
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col">
                      <span class="text-sm font-medium leading-5 text-base-content" data-role="feed_preset">{card.name}</span>
                      <span class="truncate text-xs leading-4 text-muted">{card.description}</span>
                    </span>
                    <#Icon
                      iconify="ph:check-circle-fill"
                      class="hidden size-4 shrink-0 text-primary peer-checked:block"
                    />
                  </label>
                {/for}
              </div>
            </fieldset>
          </Dropdown>
      {/case}
    </form>

    {!-- Level 2: frequent feed adjustments. These compose with the selected mode; changing
      replies or boosts intentionally makes the content mix custom. --}
    <Bonfire.UI.Common.Settings.Calm.OverrideTogglesLive
      scope={nil}
      event_name="set_filter_overrides"
      event_mode={:click}
      event_target={@event_target}
      form_name="feed_overrides"
      form_id={"feed_overrides_form_#{@feed_name || "default"}"}
      form_role="feed_override_toggles"
      form_class="flex flex-col gap-0 pt-2 pb-1"
      row_class="-mx-2 rounded-selector px-2 transition-colors duration-150 ease-out hover:bg-base-content/5 active:bg-base-content/10"
      title_class="text-sm font-normal text-base-content"
      rows={Bonfire.UI.Social.WidgetCustomizeFeedLive.override_rows(@feed_filters, @feed_name, @__context__)}
      field_prefix="scope"
      toggle_role="feed_override_toggle"
    />

    {!-- Level 3: the full filter matrix, behind an explicit gesture — expands the all-filters editor inline.
      Deliberately quieter than the toggles above (normal weight, muted) so it reads as the door to advanced
      territory, not another setting; no border-b since the widget's own bottom border closes the block. --}
    {#case Bonfire.UI.Social.FeedControlsLive.active_filters(@feed_filters, @__context__)}
      {#match active_filters}
        <div class="-mx-2" data-role="feed_advanced_filters_wrapper">
          <Bonfire.UI.Common.OpenExpanderLive
            parent_id={"feed_filters_#{@feed_name}"}
            modal_assigns={Bonfire.UI.Social.FeedControlsLive.feed_filters_modal_assigns(assigns)}
            open_btn_wrapper_class="rounded-selector focus-ring"
            open_btn_class="min-h-11 w-full px-2 py-2 text-sm font-medium text-base-content/80 flex items-center gap-2 cursor-pointer transition-colors duration-150 ease-out hover:bg-base-content/5 hover:text-base-content active:bg-base-content/10"
            caret_class="w-4 h-4 text-base-content/70 transition-transform duration-150 ease-out motion-reduce:transition-none"
          >
            <:open_btn>
              {!-- text-led like the toggle rows above so all rows share one left
                edge, with the caret on the same right-hand axis as the toggles --}
              <span class="flex-1 text-left" data-role="feed_advanced_filters">{l("Advanced filters")}</span>
              {#if active_filters != []}
                <span
                  class="badge badge-secondary badge-xs w-5 h-5"
                  aria-label={l("%{count} active filters", count: length(active_filters))}
                >{length(active_filters)}</span>
              {/if}
            </:open_btn>
          </Bonfire.UI.Common.OpenExpanderLive>
        </div>
    {/case}

    {!-- <div class="px-4 pt-3">
      <Bonfire.UI.Social.SaveFeedPresetLive event_target={@event_target} />
    </div> --}
  </div>
</Bonfire.UI.Common.WidgetBlockLive>
