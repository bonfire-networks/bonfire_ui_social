<div
  data-role="object-thread"
  class={
    "flex flex-col flex-1",
    "!max-w-[720px] mx-auto w-full": !current_user_id(@__context__)
  }
>
  {#case e(@activity, :subject, nil) || e(@object, :created, :creator, nil)}
    {#match nil}
    {#match subject}
      <div
        :if={@thread_id && !@object_not_permitted &&
          @showing_within not in [:thread_embed, :messages]}
        id={"thread_context_header_#{@thread_id}_#{@activity_inception || "page"}"}
        :hook="ThreadContextHeader"
        class="sticky z-[999]"
        style="top: var(--spacing-page-header, 64px); height: 0"
      >
        <button
          type="button"
          data-role="thread-context-bar"
          aria-hidden="true"
          tabindex="-1"
          aria-label={l("Back to the top of the thread")}
          class="w-full flex items-center gap-2 px-3 py-1.5 text-left border-b-hair border-secondary bg-base-100/95 backdrop-blur-sm cursor-pointer opacity-0 -translate-y-1 pointer-events-none transition-all duration-150 ease-out"
        >
          <#Icon iconify="ph:arrow-up-bold" class="w-4 h-4 text-base-content/60 shrink-0" />
          <Bonfire.UI.Common.AvatarLive
            parent_id={"thread_ctx_#{@thread_id}_#{@activity_inception || "page"}"}
            user_id={id(subject)}
            src={Media.avatar_url(subject)}
            title={e(subject, :profile, :name, nil) || e(subject, :character, :username, nil)}
            wrapper_class="shrink-0 !w-6 !h-6 avatar border-0"
            bg_class="rounded-full"
            class="w-6 h-6 rounded-full"
          />
          <span class="text-sm font-medium truncate">{e(subject, :profile, :name, nil) || e(subject, :character, :username, nil)}</span>
          <span class="text-xs text-base-content/60 shrink-0">{DatesTimes.date_from_now(id(@object) || @object_id || @thread_id)}</span>
          <span class="ml-auto text-xs text-base-content/60 shrink-0">{l("Back to post")}</span>
        </button>
      </div>
  {/case}
  <div class="flex-1">
    {!-- INITIAL POST --}
    <div class="relative">
      <div class="overflow-visible p-card bg-base-100 border-0 border-b-(length:--divider-width) border-(color:--divider-color) rounded-none shadow-none" id="thread_main_object">
        {#if @object_not_permitted}
          <StatelessComponent
            module={maybe_component(Bonfire.UI.Social.RestrictedContentLive, @__context__)}
            object_type_name={@object_not_permitted}
            object_id={@object_id || @post_id || @thread_id}
          />
        {#elseif is_nil(@activity) and is_nil(@object)}
          <div
            data-id="object_not_viewable"
            class="flex flex-col items-center w-full max-w-prose px-6 py-12 mx-auto text-center"
          >
            <div
              class="flex items-center justify-center w-16 h-16 rounded-full bg-base-content/5"
              aria-hidden="true"
            >
              <#Icon iconify="ph:eye-slash-duotone" class="w-8 h-8 text-muted" />
            </div>
            <h2 class="mt-4 text-lg font-semibold text-base-content">{l("Sorry, you cannot view this.")}</h2>
            <p class="mt-1 text-sm text-base-content/80">{l("It may have been deleted, or you may not have permission to see it.")}</p>
          </div>
        {#else}
          {#if @custom_preview}
            <div>
              <StatelessComponent
                thread_title={@thread_title}
                activity={@activity}
                showing_within={@showing_within}
                object={@object}
                main_object_component_id={@main_object_component_id}
                module={maybe_component(@custom_preview, @__context__)}
              />
            </div>
          {#else}
            <Bonfire.UI.Social.ActivityLive
              class=""
              id={@main_object_component_id}
              showing_within={@showing_within}
              thread_mode={@thread_mode}
              thread_title={@thread_title}
              viewing_main_object
              activity={@activity}
              object={@object}
              feed_id={@feed_id || @thread_id}
              activity_inception={@activity_inception}
              check_object_boundary={false}
              object_boundary={if @showing_within == :messages, do: :skip_boundary_check, else: :skip_boundary_preload}
            />
          {/if}
        {/if}
      </div>
      <div class="">
        <Bonfire.UI.Social.ThreadLive
          class="flex flex-col gap-0"
          replies_class="thread-replies p-0 pr-card bg-base-100 border-0 border-b-(length:--divider-width) border-(color:--divider-color) rounded-none shadow-none"
          :if={@thread_id && !@object_not_permitted}
          id={@thread_id}
          thread_id={@thread_id}
          highlight_reply_id={@reply_id}
          thread_boost_count={@root_boost_count}
          include_path_ids={@include_path_ids}
          current_url={@current_url}
          main_object_component_id={@main_object_component_id}
          feed_id={@feed_id}
          sort_by={@sort_by}
          sort_order={@sort_order}
          participants={@participants}
          thread_mode={@thread_mode}
          loading={@loading}
          replies={@replies}
          threaded_replies={@threaded_replies}
          page_info={@page_info}
          activity={@activity}
          object={@object}
          showing_within={@showing_within || :thread}
          activity_inception={@activity_inception}
          hide_thread_stats={@hide_thread_stats}
        />
      </div>
    </div>
  </div>
</div>
