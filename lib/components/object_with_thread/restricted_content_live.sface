{!-- the object being opened gets the full screen; one item of a list (`viewing_main_object: false`) the same, compact: its name and summary and why the rest isn't shown, never its body or media, and opening it (the card is previewable) shows the full screen --}
<div
  data-id="restricted_content"
  data-role={if @viewing_main_object, do: "restricted_content", else: "restricted_object"}
  class={if @viewing_main_object,
    do: "flex flex-col items-center w-full max-w-prose px-6 py-12 mx-auto text-center",
    else: "previewable_activity cursor-pointer"}
>
  {#case Bonfire.Common.Media.media_url(@primary_image)}
    {#match url when is_binary(url)}
      <div
        role="img"
        aria-label={Bonfire.Files.Media.media_alt(@primary_image)}
        data-role="restricted_cover"
        class="w-full aspect-[3/2] bg-center bg-no-repeat bg-cover overflow-hidden bg-placeholder rounded-box"
        style={["background-image": "url('#{URI.encode(url)}')"]}
      >
        <span class="sr-only">{Bonfire.Files.Media.media_alt(@primary_image)}</span>
      </div>
    {#match _}
  {/case}
  {#case Bonfire.Social.RestrictedContent.preview(nil, @object)}
    {#match preview}
      {#if preview.name}
        <div data-role="name" class="translatable text-sm my-1 mt-2">{rich(preview.name)}</div>
      {/if}
      {#if preview.summary}
        <div data-role="summary" class="translatable prose max-w-prose prose-p:pt-1">{rich(preview.summary)}</div>
      {/if}
  {/case}

  <div
    data-role="restricted_content_notice"
    class={if @viewing_main_object,
      do: "flex flex-col items-center",
      else: "flex items-center gap-2 mt-2 text-sm text-muted"}
  >
    <div
      class={if @viewing_main_object,
        do: "flex items-center justify-center size-16 rounded-full bg-primary/10",
        else: "shrink-0"}
      aria-hidden="true"
    >
      <#Icon
        iconify="ph:lock-key-duotone"
        class={if @viewing_main_object, do: "size-8 text-primary", else: "size-4"}
      />
    </div>
    <span class={"mt-4 type-heading text-base-content": @viewing_main_object}>
      {Bonfire.Social.RestrictedContent.why_not_shown(@published_in, @__context__)}
    </span>
  </div>

  {#if @viewing_main_object}
    <p class="mt-1 text-sm text-muted max-w-prose">
      {Bonfire.Social.RestrictedContent.setting(
        :message,
        l("It was shared with a limited audience."),
        @__context__
      )}
    </p>

    {#case Bonfire.Social.RestrictedContent.call_to_action(@__context__)}
      {#match cta}
        {#if cta || is_nil(current_user_id(@__context__))}
          <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
            {#if cta}
              <a
                href={cta.url}
                target={e(@__context__, :link_target, nil) || "_top"}
                rel={if e(@__context__, :link_target, nil) == "_blank", do: "noopener"}
                class="btn btn-primary"
                data-role="restricted_content_cta"
              >
                {cta.label}
              </a>
            {/if}

            {#if is_nil(current_user_id(@__context__))}
              <LinkLive
                to={path(:login, :index)}
                class="btn btn-outline"
                opts={"data-role": "restricted_login"}
              >
                {l("Sign in")}
              </LinkLive>
            {/if}
          </div>
        {/if}
    {/case}

    {#if is_nil(current_user_id(@__context__))}
      {#case @object_id &&
          maybe_apply(
            Bonfire.UI.Me.RemoteInteractionLive,
            :generate_url,
            [
              "read",
              @object_type_name || l("content"),
              Bonfire.Common.URIs.canonical_url(@object_id, preload_if_needed: true),
              @__context__
            ],
            fallback_return: nil
          )}
        {#match url when is_binary(url)}
          <LinkLive
            to={url}
            class="mt-4 text-sm link link-hover text-muted"
            opts={"data-role": "remote_interaction"}
          >
            {l("Use your account on another instance")}
          </LinkLive>
        {#match _}
      {/case}
    {/if}
  {/if}
</div>
