<nav
  id="notification-filters"
  aria-label={l("Filter notifications")}
  class="min-w-0"
>
  <p :if={any_switched_off?(@__context__)} id="notification-filters-dimmed" class="sr-only">{l("Dimmed categories are switched off in your preferences. Selecting one still shows it.")}</p>
  <ul
    id="notification-filters-list"
    phx-hook="ScrollRow"
    class="flex min-w-0 list-none gap-1.5 overflow-x-auto p-4 [scrollbar-width:none] data-[fade-end]:[mask-image:linear-gradient(to_right,black_calc(100%-3rem),transparent)] data-[fade-start]:[mask-image:linear-gradient(to_right,transparent,black_3rem)] data-[fade-start]:data-[fade-end]:[mask-image:linear-gradient(to_right,transparent,black_3rem,black_calc(100%-3rem),transparent)] [&::-webkit-scrollbar]:hidden"
  >
    {#for {key, chip} <- chips(@__context__)}
      {#case {current?(key, @selected_tab), Notifications.hidden_from_centre?(key, @__context__)}}
        {#match {current?, switched_off?}}
          <li class="shrink-0">
            {!-- a category switched off in preferences goes hollow (dashed, muted) but stays a link, since this is the way back to what the default view no longer shows. The ::before stretches the 32px pill's touch target to 44px without making the pill look chunky --}
            <LinkPatchLive
              to={chip_path(key, chip)}
              opts={[
                id: "notification-filter-#{key}",
                "aria-current": if(current?, do: "page", else: nil),
                "data-switched-off": if(switched_off?, do: "true", else: nil),
                "aria-describedby": if(switched_off?, do: "notification-filters-dimmed")
              ]}
              class={
                "relative flex h-8 items-center whitespace-nowrap rounded-full border px-3.5 text-sm font-medium transition-colors before:absolute before:inset-x-0 before:-inset-y-1.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
                "border-transparent bg-base-content text-base-100": current?,
                "border-transparent bg-fill text-base-content hover:bg-fill-strong": !current? and !switched_off?,
                "border-dashed border-divider text-muted hover:bg-fill": !current? and switched_off?
              }
            >
              {chip_label(key, chip)}
            </LinkPatchLive>
          </li>
      {/case}
    {/for}
  </ul>
</nav>
