{!-- collapsed to start with only beside the feed, where the Preferences button opens it; on its own it is the page --}
<section
  id="notification-preferences-panel"
  aria-labelledby={if @showing_within == :feed, do: "notification-preferences-title"}
  aria-label={if @showing_within != :feed, do: l("Notification preferences")}
  style={if @showing_within == :feed, do: "display: none;", else: ""}
  class={
    "text-base-content",
    "mb-8 border-b-4 border-base-content/20 pb-6": @showing_within == :feed
  }
>
  {!-- no `phx-update="ignore"`: these controls are live, and ignoring updates would freeze their checked state and the Apply button --}
  <div id="notification-preferences-controls" class="p-4 space-y-4">
    <div class="space-y-1.5">
      <h2
        :if={@showing_within == :feed}
        id="notification-preferences-title"
        class="type-heading"
      >{l("Notification preferences")}</h2>
      {!-- only the sections that are still unbuilt claim to be a preview, so a live section never says its changes are discarded --}
      <p
        :if={show_unimplemented?()}
        id="notification-preferences-preview-notice"
        class="text-xs text-muted"
      >
        {l("Some sections below are previews · Their changes are not saved")}
      </p>
    </div>

    {!-- everything about push, only where something would read it: delivery is a separate extension, while this panel configures the feed either way. Asked once here rather than per row --}
    {#case {push_available?(@__context__), email_available?(@__context__)}}
      {#match {push?, email?}}
        {!-- the real thing, not a copy of it: enabling push means asking the browser and keeping a subscription, which one component owns (`Bonfire.Notify.Settings.PushNotificationsLive`, which settings shows through this same panel) --}
        <section
          :if={push?}
          id="notification-push"
          aria-labelledby="notification-push-title"
          class="notification-push-section"
        >
          <h3 id="notification-push-title" class="sr-only">{l("Push notifications")}</h3>

          <StatefulComponent
            module={maybe_component(Bonfire.Notify.Settings.PushNotificationsLive, @__context__)}
            id="notification-push-devices"
          />
        </section>

        <fieldset class="notification-preference-matrix min-w-0 overflow-x-auto border-t border-divider pt-5 pb-1">
          <legend class="sr-only">{l("Notify me about")}</legend>
          <div class={"grid items-center gap-3 pb-3 text-xs", grid_cols(push?, email?)}>
            <span class="text-base font-medium">{l("Notify me about")}</span>
            {!-- named after the chip it affects: switching a category off drops it from Latest, while its own chip still shows it --}
            <span class="text-center text-muted">{l("Show in Latest")}</span>
            <span :if={push?} class="text-center text-muted">{l("Push")}</span>
            <span :if={email?} class="text-center text-muted">{l("Email")}</span>
          </div>
          {#for {key, label, wired?, centre?, description} <- notification_rows()}
            <div class={"grid min-h-12 items-center gap-3", grid_cols(push?, email?)}>
              <span class="flex items-center gap-1 text-sm leading-snug">
                {label}
                {!-- what the row covers, from the category's `description`: a tooltip to hover, and the same words for a screen reader, which a tooltip alone doesn't reach --}
                {#if description}
                  <span
                    id={"notification-pref-#{key}-info"}
                    class="tooltip tooltip-right inline-flex cursor-help text-subtle"
                    data-tip={description}
                    aria-describedby={"notification-pref-#{key}-description"}
                    tabindex="0"
                  >
                    <#Icon iconify="ph:info" class="size-4" aria-hidden="true" />
                  </span>
                  <span id={"notification-pref-#{key}-description"} class="sr-only">{description}</span>
                {/if}
              </span>
              {!-- a kind that never reaches the notifications feed (messages) has nothing to show in Latest, so its cell stays empty and the columns still line up --}
              <div :if={!centre?} />
              {!-- a row whose switch nothing honours yet stays inert rather than saving a setting no query reads --}
              {!-- each switch's form carries its own id: two forms in a row with the same attributes are indistinguishable to a selector, including the ones test helpers build for themselves --}
              <form
                :if={centre? and wired?}
                id={"notification-pref-#{key}-centre-form"}
                data-scope={key}
                phx-change="Bonfire.Common.Settings:set"
                class="flex min-h-6 w-full items-center justify-center"
              >
                <label class="flex cursor-pointer items-center justify-center">
                  <span class="sr-only">{l("%{type}: show in Latest notifications", type: label)}</span>
                  <Bonfire.UI.Common.SettingsToggleLive
                    id={"notification-pref-#{key}-centre"}
                    keys={Notifications.show_in_centre_key(key)}
                    default_value
                    compact
                  />
                </label>
              </form>
              <label :if={centre? and !wired?} class="flex min-h-8 cursor-pointer items-center justify-center">
                <span class="sr-only">{l("%{type}: show in Latest notifications", type: label)}</span>
                <input
                  id={"notification-pref-#{key}-centre"}
                  type="checkbox"
                  class="toggle toggle-sm toggle-primary"
                  checked
                />
              </label>
              {!-- the switch the delivery path reads: `Bonfire.Notify.Preferences` asks this key for every recipient and channel before a notification is queued --}
              <form
                :if={push? and wired?}
                id={"notification-pref-#{key}-push-form"}
                data-scope={key}
                phx-change="Bonfire.Common.Settings:set"
                class="flex min-h-8 items-center justify-center"
              >
                <label class="flex cursor-pointer items-center justify-center">
                  <span class="sr-only">{l("%{type}: push notifications", type: label)}</span>
                  <Bonfire.UI.Common.SettingsToggleLive
                    id={"notification-pref-#{key}-push"}
                    keys={push_key(key)}
                    default_value
                    compact
                  />
                </label>
              </form>
              <label :if={push? and !wired?} class="flex min-h-8 cursor-pointer items-center justify-center">
                <span class="sr-only">{l("%{type}: push notifications", type: label)}</span>
                <input
                  id={"notification-pref-#{key}-push"}
                  type="checkbox"
                  class="toggle toggle-sm toggle-primary"
                  checked
                />
              </label>
              {!-- when this kind is emailed: never, in the digest (unset, the default), or as it happens. How often the digest goes out is its own setting, which comes with the digest --}
              <div
                :if={email? and wired?}
                id={"notification-pref-#{key}-email"}
                role="group"
                aria-label={l("%{type}: email", type: label)}
                class="flex min-h-8 items-center justify-center"
              >
                <Bonfire.UI.Common.SettingsToggleThroupleLive
                  keys={email_key(key)}
                  label_no={l("Off")}
                  label_default={l("Digest")}
                  label_yes={l("Instant")}
                  reversed
                  compact
                />
              </div>
              <div :if={email? and !wired?} />
            </div>
          {/for}
        </fieldset>

        {!-- how often the digest comes, for the kinds left to it (Digest in the Email column): one choice for all of them. `Bonfire.Notify.Digest` reads it for its subject and schedule, and its own event saves it then moves the waiting digest to match. Never until chosen, here or as the instance's default (this same dropdown at instance scope) --}
        <form
          :if={email?}
          id="notification-email-digest-form"
          phx-change="Bonfire.Notify:set_email_digest"
          class="border-t border-divider pt-4"
        >
          <Bonfire.UI.Common.SettingsSelectLive
            id="notification-email-digest"
            scope={if @scope in [:instance, "instance"], do: :instance, else: :account}
            keys={[:notifications, :email_digest]}
            name={l("Email digest")}
            label_name={l("Email digest")}
            description={l("How often the kinds you left to the digest are emailed together")}
            options={[
              daily: l("Daily"),
              weekly: l("Weekly"),
              monthly: l("Monthly"),
              never: l("Never")
            ]}
            default_value={:never}
          />
        </form>
    {/case}

    {!-- the same switches the messages list and Privacy & Safety show --}
    <div class="border-t border-divider pt-5">
      <Bonfire.UI.Social.HiddenAudiencesLive />
    </div>

    <fieldset class="border-t border-divider pt-5">
      {!-- <legend class="sr-only">{l("Display")}</legend>
      <h3 class="mb-3 text-base font-medium">{l("Display")}</h3> --}
      {#for {key, toggle} <- extra_toggles()}
        <form data-scope={key} phx-change="Bonfire.Common.Settings:set" class="py-2">
          <Bonfire.UI.Common.SettingsToggleLive
            id={"notification-display-#{key}"}
            name={e(toggle, :name, key)}
            description={e(toggle, :description, nil)}
            description_tooltip
            keys={display_setting_key(key)}
            default_value={e(toggle, :default, false)}
          />
        </form>
      {/for}

      {!-- turning notifications off in bulk: the modal's component is mounted only when it opens, so its counts cost nothing until then --}
      <div :if={unsubscribe_available?(@__context__)} class="py-2">
        <Bonfire.UI.Common.OpenModalLive
          id="notification-unsubscribe"
          title_text={l("Unsubscribe")}
          no_actions
          open_btn_wrapper_class="btn btn-sm btn-ghost"
          modal_assigns={[
            modal_component: Bonfire.Notify.Web.UnsubscribeLive,
            modal_component_stateful?: true
          ]}
        >
          <:open_btn>
            {l("Unsubscribe…")}
          </:open_btn>
        </Bonfire.UI.Common.OpenModalLive>
      </div>

      {!-- switches save as you flip them; the feed is only re-queried on demand, so one reload covers however many you changed. Nothing to catch up when there is no feed beside the panel --}
      <div
        :if={@showing_within == :feed and
          display_pending?(@__context__, @feed_filters, @feed_assigns)}
        id="notification-display-apply"
        class="mt-3 flex items-center justify-between gap-3 border-t border-divider pt-3"
      >
        <p role="status" class="text-sm text-muted">{l("Saved. The feed below hasn't caught up yet.")}</p>
        {!-- applying is done with the panel, so it closes it, as the Preferences button would --}
        <button
          type="button"
          class="btn btn-sm btn-primary shrink-0"
          phx-click={JS.push("apply_notification_display")
          |> JS.hide(to: "#notification-preferences-panel")
          |> JS.set_attribute({"aria-expanded", "false"}, to: "#notification-preferences-toggle")}
        >{l("Apply to feed")}</button>
      </div>
    </fieldset>
  </div>
</section>
